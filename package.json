{
  "name": "room-layout-fengshui-planner",
  "version": "1.0.0",
  "description": "Static room layout and feng shui reference planner website.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-sitemaps.mjs && node scripts/postbuild-redirects.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:affiliate": "node scripts/generate-affiliate-assets.mjs",
    "assets:products": "node scripts/generate-product-assets.mjs",
    "audit:content": "node scripts/content-quality-audit.mjs",
    "audit:headings": "node scripts/semantic-heading-audit.mjs",
    "audit:bundle": "node scripts/bundle-size-audit.mjs",
    "test:seo-production-parity": "node scripts/seo-production-parity.mjs",
    "test:lighthouse:production": "node scripts/lighthouse-production.mjs",
    "test:production-hardening-browser": "node scripts/test/production-hardening.browser.mjs",
    "test:adsense:browser": "node scripts/test/adsense-integration.browser.mjs",
    "test:live-crawl:browser": "node scripts/test/live-crawl-006.browser.mjs",
    "audit:us-seo": "node scripts/us-seo-audit.mjs",
    "gsc:submit-sitemap": "node scripts/gsc-submit-sitemap.mjs",
    "gsc:sitemap-health": "node scripts/gsc-sitemap-health.mjs",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "test:uiux-review": "node --experimental-strip-types --test scripts/test/uiux-review-03.test.mjs scripts/test/uiux-review-04.test.mjs",
    "test:uiux-browser": "node scripts/test/uiux-review-03.browser.mjs",
    "test:uiux-review-04-browser": "node scripts/test/uiux-review-04.browser.mjs",
    "test:us-seo": "node --experimental-strip-types --test scripts/test/us-seo-calculators.test.mjs",
    "test:www-redirect": "node --test infra/www-redirect-worker/test/*.test.mjs",
    "test:moving-os": "node --experimental-strip-types --test tests/moving-os.test.mjs tests/moving-os-license.test.mjs",
    "test:product-002:entitlement": "node --experimental-strip-types --test tests/product-002-entitlement.test.mjs",
    "test:product-002:browser": "playwright test --config=playwright.product-002.config.mjs",
    "test:product-002": "node --experimental-strip-types --test tests/product-002-geometry.test.mjs",
    "test:product-002:phase3": "node --test tests/product-002-phase3.test.mjs",
    "product-002:dataset": "node --experimental-strip-types scripts/product-002-dataset.mjs",
    "product-002:persona": "node --experimental-strip-types scripts/product-002-personas.mjs",
    "product-002:phase2-qa": "node --experimental-strip-types scripts/product-002-phase2-qa.mjs",
    "product-002:qa": "node scripts/product-002-layout-qa.mjs",
    "qa:moving-os-browsers": "node --experimental-strip-types tests/moving-os-cross-browser.cjs",
    "amazon:refresh": "node scripts/amazon-content-lifecycle.mjs --refresh",
    "amazon:preflight": "node scripts/amazon-content-lifecycle.mjs --check",
    "deploy:www-redirect": "wrangler deploy --config infra/www-redirect-worker/wrangler.jsonc",
    "preflight": "npm run amazon:preflight && npm run check && npm run build && npm run audit:content && npm run audit:headings && npm run test:scripts && npm run test:www-redirect && npm run test:moving-os"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.8",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.4"
  }
}
