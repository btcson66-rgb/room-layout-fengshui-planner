{
  "name": "room-layout-fengshui-planner",
  "version": "1.0.0",
  "description": "Static room layout and feng shui reference planner website.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-sitemaps.mjs && node scripts/postbuild-redirects.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:affiliate": "node scripts/generate-affiliate-assets.mjs",
    "audit:content": "node scripts/content-quality-audit.mjs",
    "gsc:submit-sitemap": "node scripts/gsc-submit-sitemap.mjs",
    "gsc:sitemap-health": "node scripts/gsc-sitemap-health.mjs",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "test:www-redirect": "node --test infra/www-redirect-worker/test/*.test.mjs",
    "test:moving-os": "node --experimental-strip-types --test tests/moving-os.test.mjs tests/moving-os-license.test.mjs",
    "qa:moving-os-browsers": "node --experimental-strip-types tests/moving-os-cross-browser.cjs",
    "amazon:refresh": "node scripts/amazon-content-lifecycle.mjs --refresh",
    "amazon:preflight": "node scripts/amazon-content-lifecycle.mjs --check",
    "deploy:www-redirect": "wrangler deploy --config infra/www-redirect-worker/wrangler.jsonc",
    "preflight": "npm run amazon:preflight && npm run check && npm run build && npm run audit:content && npm run test:scripts && npm run test:www-redirect && npm run test:moving-os"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.8",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
