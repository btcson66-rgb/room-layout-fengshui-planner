---
interface Props {
  locale: 'en' | 'zh-TW';
  productId: string;
  productName: string;
  appHref: string;
  verifyEndpoint: string;
  sessionEndpoint: string;
  supportEmail?: string;
  movingOsMarker?: boolean;
}

const {
  locale,
  productId,
  productName,
  appHref,
  verifyEndpoint,
  sessionEndpoint,
  supportEmail = '',
  movingOsMarker = false,
} = Astro.props;
const zh = locale === 'zh-TW';
const supportHref = supportEmail ? `mailto:${supportEmail}` : '/contact/';
const copy = productId === 'roomfeng-layout-vault-v1'
  ? {
      kicker: 'ROOMFENG / LAYOUT VAULT LICENSE',
      title: zh ? '啟用 Layout Vault' : 'Activate Layout Vault',
      intro: zh
        ? '輸入購買後取得的授權碼。驗證只會傳送授權碼，不會傳送信箱、房間資料或任何專案內容。'
        : 'Enter the license key from your purchase. Verification sends only the key—never your email, room details, or project data.',
      provider: zh ? '你在哪個平台購買 Layout Vault？' : 'Where did you purchase Layout Vault?',
      key: zh ? '授權碼' : 'License key',
      activate: zh ? '啟用 Layout Vault' : 'Activate Layout Vault',
      verifying: zh ? '驗證中…' : 'Verifying…',
      success: zh ? '啟用成功，正在開啟 Layout Vault…' : 'Activation successful. Opening Layout Vault…',
      where: zh ? '授權碼在哪裡？' : 'Where do I find my license key?',
      whereText: zh
        ? '請選擇購買平台；Payhip 或 Gumroad 的收據／購買資訊會提供 Layout Vault 授權碼。'
        : 'Choose your marketplace; the Payhip or Gumroad receipt or purchase page provides your Layout Vault license key.',
      help: zh ? '已購買但無法啟用？' : "Purchased but can't activate?",
      helpItems: zh
        ? ['重新確認授權碼，避免多餘空格。', '確認目前可連上網路。', '稍後重試一次。']
        : ['Check the license key and remove extra spaces.', 'Check your internet connection.', 'Retry once after a short wait.'],
      contact: zh ? '聯絡支援' : 'Contact support',
      note: zh
        ? '啟用需要網路。格局資料與你的條件仍留在這個瀏覽器；授權會定期重新驗證。v1.0 不執行裝置數量限制。'
        : 'Activation requires internet. Layout data and your room conditions stay in this browser; the license is periodically re-verified. v1.0 does not enforce a device limit.',
      privacy: zh ? '隱私提醒：不需帳號或信箱。只會送出平台、產品與授權碼供驗證。' : 'Privacy note: no account or email is required. Only the marketplace, product, and license key are sent for verification.',
    }
  : {
      kicker: 'ROOMFENG / LICENSE ACTIVATION',
      title: zh ? '啟用 RoomFeng 搬家規劃系統' : 'Activate RoomFeng Moving OS',
      intro: zh
        ? '輸入購買後取得的授權碼。驗證只會傳送授權碼，不會傳送你的地址、房間、家具、預算或搬家資料。'
        : 'Enter the license key from your purchase. Verification sends only the key—not your address, rooms, furniture, budget, or moving project.',
      provider: zh ? '購買平台' : 'Where did you purchase?',
      key: zh ? '授權碼' : 'License key',
      activate: zh ? '啟用' : 'Activate',
      verifying: zh ? '驗證中…' : 'Verifying…',
      success: zh ? '啟用成功，正在開啟 Moving OS…' : 'Activation successful. Opening Moving OS…',
      where: zh ? '授權碼在哪裡？' : 'Where do I find my license key?',
      whereText: zh
        ? '請選擇購買平台；Payhip 或 Gumroad 的收據／購買資訊會提供授權碼。'
        : 'Select your marketplace; the Payhip or Gumroad receipt or purchase information provides the license key.',
      help: zh ? '已購買但無法啟用？' : "Purchased but can't activate?",
      helpItems: zh
        ? ['重新確認授權碼，避免多餘空格。', '確認目前可連上網路。', '稍後重試一次。']
        : ['Check the license key and remove extra spaces.', 'Check your internet connection.', 'Retry once after a short wait.'],
      contact: zh ? '聯絡支援' : 'Contact support',
      note: zh
        ? '啟用需要網路。成功後，此裝置可在短時間離線使用；授權會定期重新驗證。v1.0 不執行裝置數量限制。'
        : 'Activation requires internet. After success, this device can work offline briefly; the license is periodically re-verified. v1.0 does not enforce a device limit.',
      privacy: zh ? '隱私提醒：地址、房間、家具、預算與搬家資料不會送出。' : 'Privacy note: addresses, rooms, furniture, budgets, and moving project data are never sent.',
    };
---
<section class="activation-shell" data-product-activation data-moving-os-activation={movingOsMarker ? '' : undefined} data-locale={locale} data-app-href={appHref} data-verify-endpoint={verifyEndpoint} data-session-endpoint={sessionEndpoint} data-product-id={productId} data-product-name={productName}>
  <div class="activation-card">
    <p class="product-kicker">{copy.kicker}</p>
    <h1>{copy.title}</h1>
    <p>{copy.intro}</p>
    <form data-activation-form>
      <label>{copy.provider}<select name="provider" required><option value="payhip">Payhip</option><option value="gumroad">Gumroad</option></select></label>
      <label>{copy.key}<input name="licenseKey" required minlength="8" maxlength="128" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" /></label>
      <button class="button" type="submit" data-activate data-activate-label={copy.activate}>{copy.activate}</button>
      <p class="activation-status" role="status" aria-live="polite" data-activation-status></p>
    </form>
    <p class="activation-privacy">{copy.privacy}</p>
    <details><summary>{copy.where}</summary><p>{copy.whereText}</p></details>
    <div class="activation-help"><h2>{copy.help}</h2><ol>{copy.helpItems.map((item) => <li>{item}</li>)}<li><a href={supportHref}>{copy.contact}</a></li></ol></div>
    <p class="activation-note">{copy.note}</p>
  </div>
</section>

<script>
  import { trackProductEvent } from '../moving-os/productAnalytics';

  const root = document.querySelector<HTMLElement>('[data-product-activation]');
  if (root) {
    const locale = root.dataset.locale || 'en';
    const zh = locale === 'zh-TW';
    const productId = root.dataset.productId || '';
    const form = root.querySelector<HTMLFormElement>('[data-activation-form]');
    const button = root.querySelector<HTMLButtonElement>('[data-activate]');
    const status = root.querySelector<HTMLElement>('[data-activation-status]');
    const verifyEndpoint = root.dataset.verifyEndpoint || '/api/product/license/verify';
    const sessionEndpoint = root.dataset.sessionEndpoint || '/api/product/license/session';
    const defaultHref = root.dataset.appHref || '/';
    const activateLabel = button?.dataset.activateLabel || (zh ? '啟用' : 'Activate');
    const successMessage = productId === 'roomfeng-moving-new-home-os-v1'
      ? (zh ? '啟用成功，正在開啟 Moving OS…' : 'Activation successful. Opening Moving OS…')
      : (zh ? '啟用成功，正在開啟 Layout Vault…' : 'Activation successful. Opening Layout Vault…');
    const nextPath = () => {
      const candidate = new URLSearchParams(window.location.search).get('next');
      return candidate && candidate.startsWith('/') && !candidate.startsWith('//') ? candidate : defaultHref;
    };
    const eventExtra = { product_id: productId };
    trackProductEvent('product_activation_view', 'activation_page', locale, eventExtra);
    const reason = new URLSearchParams(window.location.search).get('reason');
    if (reason === 'revoked' && status) status.textContent = productId === 'roomfeng-moving-new-home-os-v1'
      ? (zh ? '這組授權已失效。請重新輸入授權碼，或聯絡支援。你的本機 MovingProject 沒有被刪除。' : 'Your license is no longer active. Re-enter your license key or contact support. Your local MovingProject has not been deleted.')
      : (zh ? '這組授權已失效。請重新輸入授權碼，或聯絡支援。你的本機資料沒有被刪除。' : 'Your license is no longer active. Re-enter your license key or contact support. Your local data has not been deleted.');
    fetch(sessionEndpoint, { credentials: 'same-origin', headers: { accept: 'application/json' } })
      .then((response) => response.ok ? response.json() : null)
      .then((data) => { if (data?.active) window.location.replace(nextPath()); })
      .catch(() => undefined);
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button || !status) return;
      const formData = new FormData(form);
      const provider = String(formData.get('provider') || '');
      const licenseKey = String(formData.get('licenseKey') || '').trim();
      button.disabled = true;
      button.textContent = zh ? '驗證中…' : 'Verifying…';
      status.textContent = '';
      try {
        const response = await fetch(verifyEndpoint, { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ provider, licenseKey, product: productId }) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) {
          const messages: Record<string, string> = zh
            ? { invalid_provider: '請選擇正確的購買平台。', invalid_product: '產品版本不符，請從購買頁提供的連結進入。', invalid_license: '無法驗證這組授權碼。', disabled_license: '這組授權已停用、退款或爭議中。', rate_limited: '嘗試次數過多，請稍後再試。', network_error: '目前無法連線驗證，請稍後再試。', not_configured: '授權服務尚未完成設定。' }
            : { invalid_provider: 'Choose the marketplace where you purchased.', invalid_product: 'This product version does not match the activation page.', invalid_license: 'This license key could not be verified.', disabled_license: 'This license is no longer active, refunded, or disputed.', rate_limited: 'Too many attempts. Please try again.', network_error: "We couldn't verify your license right now. Please try again.", not_configured: 'License activation is not configured yet.' };
          const code = String(data.code || 'network_error');
          status.textContent = messages[code] || messages.network_error;
          trackProductEvent('product_activation_error', code, locale, eventExtra);
          return;
        }
        status.textContent = successMessage;
        trackProductEvent('product_activation_success', 'activation_page', locale, eventExtra);
        window.location.assign(nextPath());
      } catch {
        status.textContent = zh ? '目前無法連線驗證，請稍後再試。' : "We couldn't verify your license right now. Please try again.";
        trackProductEvent('product_activation_error', 'network_error', locale, eventExtra);
      } finally {
        button.disabled = false;
        button.textContent = activateLabel;
      }
    });
  }
</script>
