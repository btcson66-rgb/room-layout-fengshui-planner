---
import '../styles/moving-os.css';
interface Props { locale: 'en' | 'zh-TW' }
const { locale } = Astro.props;
const zh = locale === 'zh-TW';
const t = zh ? {
  title: '搬家與新居規劃系統', privacy: '資料只儲存在這個瀏覽器，除非你主動匯出。', dashboard: '總覽', setup: '專案設定', measurements: '測量簿', furniture: '家具判斷', layout: '平面配置', timeline: '時間軸', boxes: '紙箱', budget: '預算', shopping: '採購比較', moveDay: '搬家當日', firstNight: '第一晚', exports: '匯出與備份', sample: '載入完整範例', empty: '建立空白專案', save: '儲存', add: '新增', why: '判斷原因', projectName: '專案名稱', currentHome: '目前住所', newHome: '新家', moveDate: '搬家日期', currency: '幣別', unit: '尺寸單位', household: '人數', bedrooms: '房間數', moveType: '搬家類型', roomName: '房間名稱', length: '長度', width: '寬度', height: '高度', doorWidth: '最窄房門寬', doorHeight: '房門高', fixed: '固定物／障礙備註', entryTitle: '入口路線（全部採同一單位）', elevatorDoor: '電梯門寬', corridor: '走廊寬', entrance: '新家入口寬', interiorDoor: '室內門寬', furnitureName: '家具名稱', category: '分類', destination: '目的房間', depth: '深度', disassemble: '可拆解', decision: '目前決定', contents: '內容物', fragile: '易碎', packed: '已打包', label: '項目', estimated: '預估', actual: '實際', paid: '已付款', task: '工作', due: '到期日', completed: '完成', exportJson: '匯出 JSON 備份', importJson: '匯入 JSON 備份', exportCsv: '匯出家具 CSV', exportXlsx: '匯出 XLSX', printPlanner: '列印完整規劃', printMoveDay: '列印搬家當日表', printLabels: '列印紙箱標籤', openPlanner: '將家具送到 Room Planner', clear: '清除本機資料', next: '下一步', preliminary: '本工具為搬家前尺寸初步檢查，不取代搬家公司現場評估。', noData: '目前沒有資料。從最大件家具或最近到期的工作開始。'
} : {
  title: 'Moving & New Home OS', privacy: 'Data stays in this browser unless you export it.', dashboard: 'Dashboard', setup: 'Project setup', measurements: 'Measurement book', furniture: 'Furniture decisions', layout: 'Room layout', timeline: 'Timeline', boxes: 'Box tracker', budget: 'Budget', shopping: 'Shopping compare', moveDay: 'Move day', firstNight: 'First night', exports: 'Exports & backup', sample: 'Load complete example', empty: 'Start blank project', save: 'Save', add: 'Add', why: 'Why?', projectName: 'Project name', currentHome: 'Current home', newHome: 'New home', moveDate: 'Move date', currency: 'Currency', unit: 'Measurement unit', household: 'Household size', bedrooms: 'Bedrooms', moveType: 'Move type', roomName: 'Room name', length: 'Length', width: 'Width', height: 'Height', doorWidth: 'Narrowest room door', doorHeight: 'Door height', fixed: 'Fixed objects / obstacles', entryTitle: 'Entry route (all in selected unit)', elevatorDoor: 'Elevator door width', corridor: 'Corridor width', entrance: 'New-home entrance width', interiorDoor: 'Interior doorway width', furnitureName: 'Furniture name', category: 'Category', destination: 'Destination room', depth: 'Depth', disassemble: 'Can disassemble', decision: 'Current decision', contents: 'Contents', fragile: 'Fragile', packed: 'Packed', label: 'Item', estimated: 'Estimated', actual: 'Actual', paid: 'Paid', task: 'Task', due: 'Due date', completed: 'Completed', exportJson: 'Export JSON backup', importJson: 'Import JSON backup', exportCsv: 'Export furniture CSV', exportXlsx: 'Export XLSX', printPlanner: 'Print complete planner', printMoveDay: 'Print move-day sheet', printLabels: 'Print box labels', openPlanner: 'Send furniture to Room Planner', clear: 'Clear local data', next: 'Next action', preliminary: 'Preliminary moving measurement check only. This does not replace an on-site mover assessment.', noData: 'No data yet. Start with the largest furniture or the nearest task.'
};
const nav = [
  ['dashboard', t.dashboard], ['setup', t.setup], ['measurements', t.measurements], ['furniture', t.furniture], ['layout', t.layout], ['timeline', t.timeline], ['boxes', t.boxes], ['budget', t.budget], ['shopping', t.shopping], ['move-day', t.moveDay], ['first-night', t.firstNight], ['exports', t.exports],
];
---

<div class="moving-os" data-moving-os data-locale={locale}>
  <header class="os-masthead">
    <div>
      <p class="os-kicker">ROOMFENG / PRODUCT 001</p>
      <h1>{t.title}</h1>
      <p class="os-privacy"><span aria-hidden="true">●</span> {t.privacy}</p>
    </div>
    <div class="os-header-actions">
      <button type="button" class="os-button os-button-quiet" data-action="load-sample">{t.sample}</button>
      <button type="button" class="os-button" data-action="new-project">{t.empty}</button>
    </div>
  </header>

  <div class="os-shell">
    <nav class="os-rail" aria-label={zh ? '產品模組' : 'Product modules'}>
      {nav.map(([id, label], index) => <button type="button" class:list={['os-nav-button', { active: index === 0 }]} data-module-target={id}><span>{String(index + 1).padStart(2, '0')}</span>{label}</button>)}
    </nav>

    <div class="os-workspace" tabindex="-1">
      <p class="os-disclaimer"><strong>{zh ? '尺寸安全提醒' : 'Measurement safety note'}</strong> — {t.preliminary}</p>
      <div class="os-live" role="status" aria-live="polite" data-live></div>

      <section class="os-module active" data-module="dashboard" aria-labelledby="dashboard-title">
        <div class="os-section-heading"><div><p class="os-eyebrow">01 / CONTROL ROOM</p><h2 id="dashboard-title">{t.dashboard}</h2></div><p data-project-subtitle></p></div>
        <div class="os-progress"><div><span data-progress-label>0% Ready</span><small>{zh ? '依完成工作、家具檢查與紙箱狀態計算' : 'Calculated from completed tasks, furniture checks, and packed boxes'}</small></div><progress max="100" value="0" data-progress></progress></div>
        <div class="os-metrics" data-dashboard-metrics></div>
        <section class="os-paper"><h3>{t.next}</h3><ol class="os-next-actions" data-next-actions></ol></section>
      </section>

      <section class="os-module" data-module="setup" aria-labelledby="setup-title">
        <div class="os-section-heading"><div><p class="os-eyebrow">02 / PROJECT BRIEF</p><h2 id="setup-title">{t.setup}</h2></div></div>
        <form class="os-form os-form-grid" data-form="project">
          <label>{t.projectName}<input name="name" required maxlength="100" /></label><label>{t.moveDate}<input name="moveDate" type="date" required /></label>
          <label>{t.currentHome}<input name="currentHome" maxlength="120" /></label><label>{t.newHome}<input name="newHome" maxlength="120" /></label>
          <label>{t.currency}<select name="currency">{['TWD','USD','EUR','GBP','JPY','KRW','HKD','SGD'].map((v)=><option>{v}</option>)}</select></label>
          <label>{t.unit}<select name="unit"><option value="cm">cm</option><option value="mm">mm</option><option value="in">inch</option></select></label>
          <label>{t.household}<input name="householdSize" type="number" min="1" max="30" required /></label><label>{t.bedrooms}<input name="bedrooms" type="number" min="0" max="50" required /></label>
          <label>{t.moveType}<select name="moveType"><option value="renting">Renting</option><option value="buying">Buying</option><option value="dorm">Dorm</option><option value="couple">Couple move</option><option value="family">Family move</option><option value="office">Office / workspace</option></select></label>
          <button class="os-button" type="submit">{t.save}</button>
        </form>
      </section>

      <section class="os-module" data-module="measurements" aria-labelledby="measurements-title">
        <div class="os-section-heading"><div><p class="os-eyebrow">03 / MEASURE TWICE</p><h2 id="measurements-title">{t.measurements}</h2></div></div>
        <form class="os-form os-form-grid" data-form="room">
          <label>{t.roomName}<input name="name" required maxlength="80" /></label><label>{t.length}<input name="length" type="number" min="0.1" max="100000" step="0.1" required /></label><label>{t.width}<input name="width" type="number" min="0.1" max="100000" step="0.1" required /></label><label>{zh ? '天花板高度' : 'Ceiling height'}<input name="ceiling" type="number" min="0.1" max="100000" step="0.1" required /></label>
          <label>{t.doorWidth}<input name="doorWidth" type="number" min="0.1" max="100000" step="0.1" /></label><label>{t.doorHeight}<input name="doorHeight" type="number" min="0.1" max="100000" step="0.1" /></label><label>{zh ? '開門方向' : 'Door swing'}<select name="doorSwing"><option value="none">None</option><option value="left">Left</option><option value="right">Right</option><option value="sliding">Sliding</option></select></label>
          <label>{zh ? '窗寬' : 'Window width'}<input name="windowWidth" type="number" min="0.1" max="100000" step="0.1" /></label><label>{zh ? '窗高' : 'Window height'}<input name="windowHeight" type="number" min="0.1" max="100000" step="0.1" /></label><label>{zh ? '窗台高度' : 'Window sill height'}<input name="windowSill" type="number" min="0" max="100000" step="0.1" /></label>
          <label>{zh ? '固定物類型' : 'Fixed-object type'}<select name="fixedType"><option value="column">Column</option><option value="cabinet">Built-in cabinet</option><option value="ac">AC</option><option value="outlet">Electrical outlet</option><option value="radiator">Radiator</option><option value="other">Other / obstruction</option></select></label><label class="span-2">{t.fixed}<input name="fixed" maxlength="240" /></label>
          <button class="os-button" type="submit">{t.add}</button>
        </form>
        <div class="os-table-wrap"><table><thead><tr><th>{t.roomName}</th><th>{t.length}</th><th>{t.width}</th><th>{zh ? '天花板' : 'Ceiling'}</th><th>{zh ? '門' : 'Door'}</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody data-room-rows></tbody></table></div>
        <form class="os-form os-form-grid os-paper" data-form="entry"><h3 class="span-all">{t.entryTitle}</h3><label>{zh ? '舊家出口寬' : 'Old-home exit width'}<input name="oldHomeExitWidthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '舊家出口高' : 'Old-home exit height'}<input name="oldHomeExitHeightMm" type="number" min="0" step="0.1" /></label><label>{zh ? '電梯內寬' : 'Elevator width'}<input name="elevatorWidthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '電梯內深' : 'Elevator depth'}<input name="elevatorDepthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '電梯內高' : 'Elevator height'}<input name="elevatorHeightMm" type="number" min="0" step="0.1" /></label><label>{t.elevatorDoor}<input name="elevatorDoorWidthMm" type="number" min="0" step="0.1" /></label><label>{t.corridor}<input name="corridorWidthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '樓梯寬' : 'Stair width'}<input name="stairWidthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '轉角平台寬' : 'Landing width'}<input name="landingWidthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '轉角平台深' : 'Landing depth'}<input name="landingDepthMm" type="number" min="0" step="0.1" /></label><label>{t.entrance}<input name="entranceWidthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '入口高度' : 'Entrance height'}<input name="entranceHeightMm" type="number" min="0" step="0.1" /></label><label>{t.interiorDoor}<input name="interiorDoorWidthMm" type="number" min="0" step="0.1" /></label><label>{zh ? '室內門高度' : 'Interior door height'}<input name="interiorDoorHeightMm" type="number" min="0" step="0.1" /></label><button class="os-button" type="submit">{t.save}</button></form>
      </section>

      <section class="os-module" data-module="furniture" aria-labelledby="furniture-title">
        <div class="os-section-heading"><div><p class="os-eyebrow">04 / THREE GATES</p><h2 id="furniture-title">{t.furniture}</h2></div></div>
        <div class="os-gates"><article><b>GATE 1</b><h3>{zh ? '搬得進去' : 'Transport / Entry Fit'}</h3></article><article><b>GATE 2</b><h3>{zh ? '放得下' : 'Room Fit'}</h3></article><article><b>GATE 3</b><h3>{zh ? '用得順' : 'Usability'}</h3></article></div>
        <form class="os-form os-form-grid" data-form="furniture"><label>{t.furnitureName}<input name="name" maxlength="100" required /></label><label>{t.category}<select name="category">{['bed','mattress','wardrobe','desk','chair','sofa','dining-table','cabinet','shelving','tv','appliance','other'].map((v)=><option value={v}>{v}</option>)}</select></label><label>{zh ? '目前房間' : 'Current room'}<input name="currentRoom" maxlength="80" /></label><label>{t.destination}<select name="destinationRoomId" data-room-options required></select></label><label>{t.width}<input name="width" type="number" min="0.1" step="0.1" required /></label><label>{t.depth}<input name="depth" type="number" min="0.1" step="0.1" required /></label><label>{t.height}<input name="height" type="number" min="0.1" step="0.1" required /></label><label>{zh ? '重量（kg，可選）' : 'Weight (kg, optional)'}<input name="weightKg" type="number" min="0" step="0.1" /></label><label class="os-check"><input name="canDisassemble" type="checkbox" /> {t.disassemble}</label><label>{zh ? '拆解後寬' : 'Disassembled width'}<input name="disassembledWidth" type="number" min="0" step="0.1" /></label><label>{zh ? '拆解後深' : 'Disassembled depth'}<input name="disassembledDepth" type="number" min="0" step="0.1" /></label><label>{zh ? '拆解後高' : 'Disassembled height'}<input name="disassembledHeight" type="number" min="0" step="0.1" /></label><label>{zh ? '購買價值（可選）' : 'Purchase value (optional)'}<input name="purchaseValue" type="number" min="0" step="0.01" /></label><label>{zh ? '照片（可選，最大 1 MB）' : 'Photo (optional, 1 MB max)'}<input name="photo" type="file" accept="image/png,image/jpeg,image/webp" /></label><label class="os-check"><input name="fragile" type="checkbox" /> {t.fragile}</label><label class="os-check"><input name="expensive" type="checkbox" /> {zh ? '高價' : 'Expensive'}</label><label class="os-check"><input name="requiresMovers" type="checkbox" /> {zh ? '需搬家公司' : 'Requires movers'}</label><label>{t.decision}<select name="decision">{['keep','sell','donate','dispose','undecided'].map((v)=><option value={v}>{v}</option>)}</select></label><label class="span-2">{zh ? '備註' : 'Notes'}<textarea name="notes" maxlength="500"></textarea></label><button class="os-button" type="submit">{t.add}</button></form>
        <div class="os-card-list" data-furniture-list></div>
      </section>

      <section class="os-module" data-module="layout" aria-labelledby="layout-title"><div class="os-section-heading"><div><p class="os-eyebrow">05 / TEST THE FLOOR</p><h2 id="layout-title">{t.layout}</h2></div></div><div class="os-layout-diagram" aria-label={zh ? '房間平面示意圖' : 'Room plan diagram'}><svg viewBox="0 0 720 360" role="img"><title>{zh ? '程式化平面圖示意' : 'Programmatic floor plan illustration'}</title><rect x="72" y="40" width="560" height="270"/><path d="M72 230h78a78 78 0 0 0-78-78"/><rect class="furn bed" x="370" y="70" width="210" height="120"/><rect class="furn sofa" x="130" y="90" width="150" height="68"/><path class="dimension" d="M72 332h560m-560-8v16m560-16v16"/><text x="352" y="352">480 cm</text><path class="walk" d="M106 250 C230 250 260 215 335 210 S500 244 610 240"/></svg></div><p>{zh ? '選擇房間並把家具、門窗送進既有 RoomFeng Room Planner；完成配置後回到本頁，把目前方案儲存為 Layout A／B／C。每個槽位可覆寫與還原。' : 'Choose a room and send its furniture and openings into the existing RoomFeng Room Planner. Return after arranging it, then save the current plan as Layout A / B / C. Each slot can be replaced or restored.'}</p><label class="os-layout-room">{zh ? '要規劃的房間' : 'Room to plan'}<select data-layout-room data-room-options></select></label><button type="button" class="os-button" data-action="open-planner">{t.openPlanner}</button><div class="os-layout-slots" data-layout-list></div></section>

      <section class="os-module" data-module="timeline" aria-labelledby="timeline-title"><div class="os-section-heading"><div><p class="os-eyebrow">06 / COUNT BACK</p><h2 id="timeline-title">{t.timeline}</h2></div></div><form class="os-form os-inline-form" data-form="timeline"><label>{t.task}<input name="title" maxlength="140" required /></label><label>{t.due}<input name="dueDate" type="date" required /></label><button class="os-button" type="submit">{t.add}</button></form><div class="os-checklist" data-timeline-list></div></section>

      <section class="os-module" data-module="boxes" aria-labelledby="boxes-title"><div class="os-section-heading"><div><p class="os-eyebrow">07 / FIND IT FAST</p><h2 id="boxes-title">{t.boxes}</h2></div></div><form class="os-form os-form-grid" data-form="box"><label>Box ID<input name="id" placeholder="BDR-014" maxlength="24" required /></label><label>{t.destination}<select name="roomId" data-room-options required></select></label><label>{t.contents}<input name="contents" maxlength="180" required /></label><label>{zh ? '優先度' : 'Priority'}<select name="priority"><option value="low">Low</option><option value="normal" selected>Normal</option><option value="high">High</option></select></label><label class="os-check"><input name="fragile" type="checkbox" /> {t.fragile}</label><label class="os-check"><input name="firstNight" type="checkbox" /> {zh ? '第一晚' : 'First night'}</label><label class="os-check"><input name="openFirst" type="checkbox" /> {zh ? '優先開箱' : 'Open first'}</label><button class="os-button" type="submit">{t.add}</button></form><div class="os-table-wrap"><table><thead><tr><th>ID</th><th>{t.destination}</th><th>{t.contents}</th><th>{zh ? '旗標' : 'Flags'}</th><th>{t.packed}</th><th>{zh ? '已裝車' : 'Loaded'}</th><th>{zh ? '已送達' : 'Delivered'}</th><th>{zh ? '已拆箱' : 'Unpacked'}</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody data-box-rows></tbody></table></div></section>

      <section class="os-module" data-module="budget" aria-labelledby="budget-title"><div class="os-section-heading"><div><p class="os-eyebrow">08 / MONEY MAP</p><h2 id="budget-title">{t.budget}</h2></div></div><div class="os-metrics" data-budget-metrics></div><form class="os-form os-form-grid" data-form="budget"><label>{t.label}<input name="label" maxlength="100" required /></label><label>{t.category}<select name="category">{['movers','packing','cleaning','transport','deposit','utilities','internet','furniture','appliances','repairs','storage','fees','other'].map((v)=><option value={v}>{v}</option>)}</select></label><label>{t.estimated}<input name="estimated" type="number" min="0" step="0.01" required /></label><label>{t.actual}<input name="actual" type="number" min="0" step="0.01" /></label><label>{t.due}<input name="dueDate" type="date" /></label><label>{zh ? '備註' : 'Notes'}<input name="notes" maxlength="240" /></label><button class="os-button" type="submit">{t.add}</button></form><div class="os-table-wrap"><table><thead><tr><th>{t.label}</th><th>{t.estimated}</th><th>{t.actual}</th><th>{t.due}</th><th>{t.paid}</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody data-budget-rows></tbody></table></div></section>

      <section class="os-module" data-module="shopping" aria-labelledby="shopping-title"><div class="os-section-heading"><div><p class="os-eyebrow">09 / BUY WITH DIMENSIONS</p><h2 id="shopping-title">{t.shopping}</h2></div></div><p>{zh ? '候選 A／B／C 按同一採購群組並排比較；外部網址只接受 http(s)，不自動開啟或追蹤。' : 'Candidates A / B / C are compared within the same group. External URLs accept only http(s), and are never opened or tracked automatically.'}</p><form class="os-form os-form-grid" data-form="shopping"><label>{zh ? '比較群組' : 'Comparison group'}<input name="group" placeholder="sofa" maxlength="60" required /></label><label>{zh ? '候選' : 'Candidate'}<select name="candidate"><option>A</option><option>B</option><option>C</option></select></label><label>{zh ? '商品' : 'Product'}<input name="product" maxlength="120" required /></label><label>{t.category}<select name="category">{['bed','mattress','wardrobe','desk','chair','sofa','dining-table','cabinet','shelving','tv','appliance','other'].map((v)=><option value={v}>{v}</option>)}</select></label><label>{zh ? '商店' : 'Store'}<input name="store" maxlength="80" /></label><label>URL<input name="url" type="url" maxlength="500" /></label><label>{zh ? '價格' : 'Price'}<input name="price" type="number" min="0" step="0.01" /></label><label>{t.destination}<select name="roomId" data-room-options required></select></label><label>{t.width}<input name="width" type="number" min="0.1" step="0.1" required /></label><label>{t.depth}<input name="depth" type="number" min="0.1" step="0.1" required /></label><label>{t.height}<input name="height" type="number" min="0.1" step="0.1" required /></label><label>{zh ? '配送' : 'Delivery'}<input name="delivery" maxlength="80" /></label><label>{zh ? '優先度' : 'Priority'}<select name="priority"><option value="low">Low</option><option value="normal" selected>Normal</option><option value="high">High</option></select></label><label>{zh ? '狀態' : 'Status'}<select name="status">{['research','shortlisted','buy','bought','reject'].map((v)=><option value={v}>{v}</option>)}</select></label><label>{zh ? '評分（0–5）' : 'Rating (0–5)'}<input name="rating" type="number" min="0" max="5" step="0.1" /></label><label class="span-2">{zh ? '備註' : 'Notes'}<textarea name="notes" maxlength="500"></textarea></label><button class="os-button" type="submit">{t.add}</button></form><div class="os-card-list os-shopping-grid" data-shopping-list></div></section>

      <section class="os-module" data-module="move-day" aria-labelledby="move-day-title"><div class="os-section-heading"><div><p class="os-eyebrow">10 / COMMAND SHEET</p><h2 id="move-day-title">{t.moveDay}</h2></div></div><form class="os-form os-form-grid" data-form="move-day"><label>{zh ? '搬家公司聯絡' : 'Mover contact'}<input name="moverContact" maxlength="160" /></label><label>{zh ? '大樓聯絡' : 'Building contact'}<input name="buildingContact" maxlength="160" /></label><label>{zh ? '停車／卸貨' : 'Parking / loading'}<input name="parking" maxlength="200" /></label><label>{zh ? '電梯預約' : 'Elevator reservation'}<input name="elevatorReservation" maxlength="200" /></label><label class="span-all">{zh ? '備註' : 'Notes'}<textarea name="notes" maxlength="500"></textarea></label><button class="os-button" type="submit">{t.save}</button></form><div class="os-command-preview" data-move-day-preview></div></section>

      <section class="os-module" data-module="first-night" aria-labelledby="first-night-title"><div class="os-section-heading"><div><p class="os-eyebrow">11 / OPEN FIRST</p><h2 id="first-night-title">{t.firstNight}</h2></div></div><form class="os-form os-inline-form" data-form="first-night"><label>{t.label}<input name="label" maxlength="120" required /></label><button class="os-button" type="submit">{t.add}</button></form><div class="os-checklist" data-first-night-list></div></section>

      <section class="os-module" data-module="exports" aria-labelledby="exports-title"><div class="os-section-heading"><div><p class="os-eyebrow">12 / TAKE IT WITH YOU</p><h2 id="exports-title">{t.exports}</h2></div></div><div class="os-export-grid"><button type="button" class="os-export" data-action="export-json"><b>JSON</b><span>{t.exportJson}</span></button><label class="os-export"><b>JSON</b><span>{t.importJson}</span><input class="sr-only" type="file" accept="application/json,.json" data-import-json /></label><button type="button" class="os-export" data-action="export-csv"><b>CSV</b><span>{t.exportCsv}</span></button><button type="button" class="os-export" data-action="export-xlsx"><b>XLSX</b><span>{t.exportXlsx}</span></button><button type="button" class="os-export" data-action="print-planner"><b>PDF</b><span>{t.printPlanner}</span></button><button type="button" class="os-export" data-action="print-move-day"><b>PDF</b><span>{t.printMoveDay}</span></button><button type="button" class="os-export" data-action="print-labels"><b>PDF</b><span>{t.printLabels}</span></button></div><button type="button" class="os-danger" data-action="clear">{t.clear}</button></section>
    </div>
  </div>
</div>

<script>
  import { initMovingOs } from '../moving-os/app';
  document.querySelectorAll<HTMLElement>('[data-moving-os]').forEach(initMovingOs);
  document.querySelectorAll<HTMLElement>('[data-moving-os]').forEach((root) => {
    const locale = root.dataset.locale === 'zh-TW' ? 'zh' : 'en';
    const activationHref = `/${locale}/moving-new-home-os/activate/?next=${encodeURIComponent(window.location.pathname)}&reason=revoked`;
    const check = async (): Promise<void> => {
      try {
        const response = await fetch('/api/product/license/status', { credentials: 'same-origin', headers: { accept: 'application/json' }, cache: 'no-store' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data?.active !== true) { window.location.replace(activationHref); return; }
      } catch { /* A temporary network failure is handled by the server grace policy on the next check. */ }
      const interval = Number((window as Window & { __ROOMFENG_QA_REVALIDATION_INTERVAL_MS?: unknown }).__ROOMFENG_QA_REVALIDATION_INTERVAL_MS) || 15 * 60 * 1000;
      window.setTimeout(check, interval);
    };
    const interval = Number((window as Window & { __ROOMFENG_QA_REVALIDATION_INTERVAL_MS?: unknown }).__ROOMFENG_QA_REVALIDATION_INTERVAL_MS) || 15 * 60 * 1000;
    window.setTimeout(check, interval);
  });
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/moving-os-sw.js', { scope: '/' }).then(async (registration) => {
      const worker = registration.active || registration.waiting || registration.installing;
      const urls = [window.location.pathname, ...performance.getEntriesByType('resource').map((entry) => (entry as PerformanceResourceTiming).name).filter((url) => url.startsWith(location.origin) && url.includes('/_astro/')).map((url) => new URL(url).pathname)];
      worker?.postMessage({ type: 'CACHE_MOVING_OS', urls: [...new Set(urls)] });
    }).catch(() => undefined);
  }
</script>
