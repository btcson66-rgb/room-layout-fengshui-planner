---
interface Provider { enabled: boolean; checkoutUrl: string; productId?: string; productLink?: string }
interface Props { locale: 'en' | 'zh-TW'; activationHref: string; previewHref: string; providers: { payhip: Provider; gumroad: Provider }; priceLabel: string; supportEmail: string; refundPolicyUrl: string }
const { locale, activationHref, previewHref, providers, priceLabel, supportEmail, refundPolicyUrl } = Astro.props;
const zh = locale === 'zh-TW';
const payhip = providers.payhip;
const gumroad = providers.gumroad;
const hasCheckout = (provider: Provider) => provider.enabled && Boolean(provider.checkoutUrl);
---
<div class="product-sales">
  <section class="product-hero">
    <div class="container product-hero-grid">
      <div><p class="product-kicker">ROOMFENG / MOVING SYSTEM 001</p><h1>{zh ? '搬家前，把會出錯的事情先解決。' : 'Plan the move before moving day.'}</h1><p class="product-lead">{zh ? '家具搬不搬得進去、放不放得下、要不要帶、紙箱在哪、預算多少、搬家當天怎麼放，一套工具一次整理。' : 'Check what fits, decide what to move, organize boxes, control your budget, and plan your new home in one private workspace.'}</p><p class="product-price">{priceLabel} · {zh ? '一次購買' : 'one-time purchase'}</p><div class="product-actions" data-product-cta-view="sales_hero">{hasCheckout(payhip) && <a class="button" href={payhip.checkoutUrl} rel="nofollow" data-product-checkout="hero" data-provider="payhip" data-product-id="roomfeng-moving-new-home-os-v1">{zh ? '用 Payhip 購買 — US$12.99' : 'Get Moving & New Home OS — $12.99'}</a>}{hasCheckout(gumroad) && <a class="button secondary" href={gumroad.checkoutUrl} rel="nofollow" data-product-checkout="hero" data-provider="gumroad" data-product-id="roomfeng-moving-new-home-os-v1">{zh ? 'Gumroad 購買' : 'Buy on Gumroad'}</a>}<a class="button secondary" href={previewHref} download data-product-cta="free_preview">{zh ? '下載免費預覽包' : 'Download the free preview'}</a></div><p class="product-note">{zh ? '不需 RoomFeng 帳號、沒有 AI API。啟用授權時需要網路；地址、日期、房間、家具與預算仍留在你的瀏覽器。' : 'No RoomFeng account and no AI API. License activation needs internet; addresses, dates, rooms, furniture, and budget stay in your browser.'}</p><p class="already-bought"><a href={activationHref}>{zh ? '已購買？輸入授權碼啟用' : 'Already purchased? Activate your license'}</a></p></div>
      <div class="blueprint-preview" role="img" aria-label={zh ? '家具搬運路線與房間尺寸圖' : 'Furniture route and room dimension diagram'}><svg viewBox="0 0 620 470"><path class="wall" d="M70 70h480v330H70V70m0 210h110m90 0h280M340 70v120m0 90v120"/><path class="door" d="M180 280a90 90 0 0 1 90-90"/><rect class="object" x="385" y="105" width="120" height="70"/><rect class="object" x="115" y="315" width="180" height="55"/><path class="route" d="M40 235c90 0 90-80 190-80s100 100 210 100"/><path class="dimension" d="M70 425h480m-480-9v18m480-18v18"/><text x="278" y="452">4.80 m</text><circle cx="440" cy="255" r="9"/><text x="457" y="263">GATE 3</text></svg><div class="preview-caption"><span>01</span><p>{zh ? '量出完整路線，不只量房門。' : 'Measure the route, not only the room door.'}</p></div></div>
    </div>
  </section>
  <section class="product-proof" aria-labelledby="product-proof-heading"><div class="container"><p class="product-kicker">SEE THE WORKING SYSTEM</p><h2 id="product-proof-heading">{zh ? '這不是另一份搬家清單 PDF。' : 'This is not another moving checklist PDF.'}</h2><p class="product-proof-lead">{zh ? '先看實際工作畫面，再決定這套系統是否適合你的搬家。' : 'A working system for a real move. See the screens before you decide.'}</p><div class="proof-grid"><article class="proof-card"><div class="proof-screen proof-dashboard"><span>MOVE DASHBOARD</span><b>12 tasks next</b><i></i><i></i><i></i></div><h3>{zh ? 'Dashboard' : 'Dashboard'}</h3><p>{zh ? '把時間軸、紙箱、預算與下一步放在同一頁。' : 'See the timeline, boxes, budget, and next actions together.'}</p></article><article class="proof-card"><div class="proof-screen proof-fit"><span>FURNITURE FIT</span><b>GATE 1 · GATE 2 · GATE 3</b><i></i><i></i><i></i></div><h3>{zh ? 'Furniture Fit' : 'Furniture Fit'}</h3><p>{zh ? '知道一件家具為什麼通過、需要確認或不值得搬。' : 'Know why each piece fits, needs review, or should stay behind.'}</p></article><article class="proof-card"><div class="proof-screen proof-room"><span>ROOM PLANNER</span><b>2.40 m × 3.60 m</b><i></i><i></i><i></i></div><h3>{zh ? 'Room Planner' : 'Room Planner'}</h3><p>{zh ? '把新家尺寸、門窗與家具放在同一個可操作平面。' : 'Place measured rooms, openings, and furniture on one usable plan.'}</p></article><article class="proof-card"><div class="proof-screen proof-box"><span>BOX TRACKER</span><b>BOX-014 · KITCHEN</b><i></i><i></i><i></i></div><h3>{zh ? 'Box Tracker' : 'Box Tracker'}</h3><p>{zh ? '紙箱編號、房間、內容與優先順序，不必靠記憶。' : 'Track box numbers, rooms, contents, and first-night priority.'}</p></article></div></div></section>
  <section class="container product-section"><p class="product-kicker">THE THREE-GATE METHOD</p><h2>{zh ? '搬得進去、放得下、用得順。三關少一關都不算完成。' : 'Get it in. Make it fit. Make it usable. Miss one gate and the job is not done.'}</h2><div class="sales-gates"><article><span>01</span><h3>{zh ? '搬得進去' : 'Entry fit'}</h3><p>{zh ? '舊家出口、電梯、樓梯、走廊、轉角、新家入口與拆解後尺寸。' : 'Old-home exit, elevator, stairs, corridor, turns, new-home entry, and disassembled size.'}</p></article><article><span>02</span><h3>{zh ? '放得下' : 'Room fit'}</h3><p>{zh ? '以淨尺寸、門窗、固定物與兩種 90° 方向做初步邊界檢查。' : 'Check usable room dimensions, openings, fixed objects, and both 90° orientations.'}</p></article><article><span>03</span><h3>{zh ? '用得順' : 'Usability'}</h3><p>{zh ? '再看床邊、椅背、櫃門、抽屜與主要動線所需空間。' : 'Then review bedside access, chair pullback, doors, drawers, and main circulation.'}</p></article></div><p class="measurement-caveat">{zh ? '這是搬家前初步尺寸檢查，不是保證搬得進去；複雜三維旋轉、材料彈性與現場搬運技巧仍需搬家公司確認。' : 'This is a preliminary measurement check, not a guaranteed fit. Complex 3D rotation, material flexibility, and mover technique still require an on-site review.'}</p></section>
  <section class="product-included"><div class="container"><p class="product-kicker">WHAT'S INCLUDED</p><h2>{zh ? '一套可以反覆使用的搬家作業系統。' : 'A moving operating system you can use again.'}</h2><div class="included-grid">{[
    ['Interactive', zh ? '互動規劃器' : 'Interactive planner', zh ? '專案、尺寸、家具、工作、紙箱、預算與採購比較。' : 'Project, measurements, furniture, tasks, boxes, budget, and shopping comparisons.'],
    ['Spreadsheet', zh ? '正式 XLSX' : 'Professional XLSX', zh ? '9 張工作表、篩選、凍結窗格、公式、列印設定與驗證。' : 'Nine sheets with filters, frozen panes, formulas, print settings, and validation.'],
    ['Printable', zh ? 'A4 與 Letter PDF' : 'A4 and Letter PDFs', zh ? '為手寫與黑白列印設計，不是網站截圖。' : 'Designed for handwriting and monochrome printing, not a website screenshot.'],
    ['Backup', zh ? '可攜備份' : 'Portable backup', zh ? 'JSON 備份、CSV 家具表與本機資料還原。' : 'JSON backup, furniture CSV, and local data recovery.'],
  ].map(([no,title,copy]) => <article><span>{no}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>{hasCheckout(payhip) && <p class="section-cta"><a class="button" href={payhip.checkoutUrl} rel="nofollow" data-product-checkout="contents" data-provider="payhip" data-product-id="roomfeng-moving-new-home-os-v1">{zh ? 'Payhip 購買完整系統' : 'Get everything on Payhip'}</a></p>}{hasCheckout(gumroad) && <p class="section-cta"><a class="button secondary" href={gumroad.checkoutUrl} rel="nofollow" data-product-checkout="contents" data-provider="gumroad" data-product-id="roomfeng-moving-new-home-os-v1">{zh ? 'Gumroad 購買' : 'Buy on Gumroad'}</a></p>}</div></section>
  <section class="container product-section product-split"><div><p class="product-kicker">WHO IT'S FOR</p><h2>{zh ? '給正在搬一個真實住家的人。' : 'For people moving a real home.'}</h2><ul><li>{zh ? '第一次搬出去住' : 'First apartment movers'}</li><li>{zh ? '租屋族、伴侶與家庭' : 'Renters, couples, and families'}</li><li>{zh ? '要決定舊家具帶不帶的人' : 'Anyone deciding what furniture to keep'}</li><li>{zh ? '搬家前要大量採購家具的人' : 'People buying several pieces before move-in'}</li></ul></div><div><p class="product-kicker">WHO IT'S NOT FOR</p><h2>{zh ? '它不是專業 CAD 或搬運保證。' : 'It is not professional CAD or a mover guarantee.'}</h2><ul><li>{zh ? '不建立完整三維旋轉模型' : 'No full 3D rotation model'}</li><li>{zh ? '不取代結構、建築或搬家公司評估' : 'No replacement for structural, architectural, or mover review'}</li><li>{zh ? '不含特定國家的法律意見' : 'No country-specific legal advice'}</li></ul></div></section>
  <section class="container product-section"><p class="product-kicker">FIVE-MINUTE START</p><ol class="start-steps"><li><b>{zh ? '建立搬家專案' : 'Create the move'}</b><span>{zh ? '日期、住家、幣別與單位。' : 'Date, homes, currency, and unit.'}</span></li><li><b>{zh ? '量完整路線' : 'Measure the route'}</b><span>{zh ? '從舊家出口一路量到新房間。' : 'From old-home exit to the destination room.'}</span></li><li><b>{zh ? '先加最大家具' : 'Add the largest pieces'}</b><span>{zh ? '查看三關與每個判斷理由。' : 'Review all three gates and every reason.'}</span></li><li><b>{zh ? '排工作與紙箱' : 'Plan tasks and boxes'}</b><span>{zh ? 'Dashboard 會產生下一步。' : 'The dashboard identifies what comes next.'}</span></li><li><b>{zh ? '備份並列印' : 'Back up and print'}</b><span>{zh ? '搬家日前匯出 JSON、XLSX 與指揮表。' : 'Export JSON, XLSX, and the command sheet before move day.'}</span></li></ol></section>
  <section class="container product-section product-trust"><p class="product-kicker">LOCAL-FIRST, LICENSED ACCESS</p><h2>{zh ? '你的搬家資料保持私密。' : 'Your move stays private.'}</h2><p>{zh ? '地址、房間尺寸、家具、預算、紙箱與筆記都留在你的瀏覽器。只有授權碼會送往 RoomFeng 安全端點，再由伺服器依你選擇的 Payhip 或 Gumroad 驗證。這不是完全離線產品：啟用需要網路，成功後提供短期離線使用並定期重新驗證。' : 'Room dimensions, addresses, furniture, budget, boxes, and notes stay in your browser. Only the license key reaches a secure RoomFeng endpoint, where the Payhip or Gumroad adapter verifies it. This is not completely offline: activation needs internet, then a short offline grace period is available with periodic revalidation.'}</p></section>
  <section class="container product-section product-comparison"><p class="product-kicker">FREE VS. MOVING OS</p><h2>{zh ? '免費工具仍然免費；付費版是完整工作流程升級。' : 'Free tools stay free. Moving OS is the workflow upgrade.'}</h2><div class="comparison-wrap"><table><thead><tr><th>{zh ? '免費 RoomFeng' : 'Free RoomFeng'}</th><th>{zh ? 'Moving OS' : 'Moving OS'}</th></tr></thead><tbody><tr><td>{zh ? '單一房間規劃' : 'One-room planning'}</td><td>{zh ? '整個搬家 Project' : 'A whole move project'}</td></tr><tr><td>{zh ? '單一家具檢查' : 'Single furniture check'}</td><td>{zh ? 'Furniture Inventory' : 'Furniture inventory'}</td></tr><tr><td>{zh ? '手動管理' : 'Manual follow-up'}</td><td>{zh ? 'Timeline、Boxes、Budget、Move Day' : 'Timeline, boxes, budget, and move day'}</td></tr><tr><td>—</td><td>{zh ? 'XLSX、Printable、JSON 備份' : 'XLSX, printable sheets, and JSON backup'}</td></tr></tbody></table></div></section>
  <section class="product-final"><div class="container" data-product-cta-view="sales_final"><p class="product-kicker">PLAN ONCE. VERIFY TWICE.</p><h2>{zh ? '少一次退貨、少一件卡在轉角的家具，這套系統就已經回本。' : 'One avoided return or one sofa that does not get stuck at a turn can pay for the entire system.'}</h2>{hasCheckout(payhip) && <a class="button" href={payhip.checkoutUrl} rel="nofollow" data-product-checkout="final" data-provider="payhip" data-product-id="roomfeng-moving-new-home-os-v1">{zh ? 'Payhip 開始規劃' : 'Start on Payhip'}</a>}{hasCheckout(gumroad) && <a class="button secondary" href={gumroad.checkoutUrl} rel="nofollow" data-product-checkout="final" data-provider="gumroad" data-product-id="roomfeng-moving-new-home-os-v1">{zh ? 'Gumroad 開始規劃' : 'Start on Gumroad'}</a>}{!hasCheckout(payhip) && !hasCheckout(gumroad) && <a class="button" href={activationHref}>{zh ? '已購買？啟用授權' : 'Already purchased? Activate'}</a>}<p>{zh ? '退款與購買條款以你選擇的平台 checkout 顯示的正式條款為準。' : 'Refund and purchase terms are governed by the marketplace checkout you choose.'} {refundPolicyUrl && <a href={refundPolicyUrl}>{zh ? '查看補充說明' : 'Read the supplemental policy'}</a>} {supportEmail ? <span>{zh ? `支援信箱：${supportEmail}` : `Support: ${supportEmail}`}</span> : <span>{zh ? '正式支援信箱尚待產品方設定。' : 'The production support email is awaiting owner configuration.'}</span>}</p></div></section>
</div>

<script>
  import { trackProductEvent } from '../moving-os/productAnalytics';
  const locale = document.documentElement.lang || 'en';
  trackProductEvent('product_view', 'sales_page', locale);
  const preview = document.querySelector<HTMLElement>('.blueprint-preview');
  if (preview && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => { if (entries.some((entry) => entry.isIntersecting)) { trackProductEvent('product_preview_view', 'hero_blueprint', locale); observer.disconnect(); } }, { threshold: 0.5 });
    observer.observe(preview);
  }
  document.querySelectorAll<HTMLElement>('[data-product-cta]').forEach((element) => element.addEventListener('click', () => trackProductEvent('product_cta_click', element.dataset.productCta || 'unknown', locale)));
  document.querySelectorAll<HTMLElement>('[data-product-checkout]').forEach((element) => element.addEventListener('click', () => trackProductEvent('product_checkout_click', element.dataset.productCheckout || 'unknown', locale, { provider: element.dataset.provider || 'unknown', product_id: element.dataset.productId || 'roomfeng-moving-new-home-os-v1' })));
  const ctaViews = document.querySelectorAll<HTMLElement>('[data-product-cta-view]');
  const markCtaView = (element: HTMLElement) => trackProductEvent('product_cta_view', element.dataset.productCtaView || 'unknown', locale);
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => { entries.filter((entry) => entry.isIntersecting).forEach((entry) => { markCtaView(entry.target as HTMLElement); observer.unobserve(entry.target); }); }, { threshold: 0.25 });
    ctaViews.forEach((element) => observer.observe(element));
  } else ctaViews.forEach(markCtaView);
</script>
