---
interface Props {
  id: string;
  adSlot?: string;
  slot?: string;
}

const { id, adSlot, slot: legacySlot } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || import.meta.env.PUBLIC_ADSENSE_ID;
const adUnitSlot = adSlot || legacySlot;
const adSlotScript = `
(() => {
  const root = document.getElementById(${JSON.stringify(id)});
  const ad = root?.querySelector('.adsbygoogle');
  if (!(root instanceof HTMLElement) || !(ad instanceof HTMLElement)) return;

  const stats = window.__roomfengAdSenseStats = window.__roomfengAdSenseStats || {
    initAttempts: 0,
    initializedSlots: 0,
    duplicateInitializations: 0,
    loaderLoaded: false,
  };
  const planner = document.querySelector('[data-planner]');
  let plannerReady = !planner;
  let plannerInteractive = !planner;
  let initializing = false;
  let initialized = ad.dataset.adInitialized === 'true';

  const scheduleIdle = (callback) => {
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(callback, { timeout: 2000 });
      return;
    }
    window.requestAnimationFrame(() => window.requestAnimationFrame(callback));
  };
  const scheduleFrames = (callback) => window.requestAnimationFrame(() => window.requestAnimationFrame(callback));
  const hasMeasurableWidth = () => root.isConnected
    && root.getBoundingClientRect().width > 0
    && ad.getBoundingClientRect().width > 0;

  const tryInit = () => {
    if (initialized || ad.dataset.adInitialized === 'true') {
      if (!initialized) stats.duplicateInitializations += 1;
      return;
    }
    if (initializing || !plannerReady || !plannerInteractive || !hasMeasurableWidth()) return;
    if (typeof window.__roomfengLoadAdSense !== 'function') return;

    initializing = true;
    stats.initAttempts += 1;
    scheduleIdle(() => {
      if (!plannerReady || !plannerInteractive || !hasMeasurableWidth()) {
        initializing = false;
        return;
      }
      Promise.resolve(window.__roomfengLoadAdSense()).then(() => {
        scheduleFrames(() => {
          if (!plannerReady || !plannerInteractive || !hasMeasurableWidth()) {
            initializing = false;
            return;
          }
          if (initialized || ad.dataset.adInitialized === 'true') {
            stats.duplicateInitializations += 1;
            initializing = false;
            return;
          }
          ad.dataset.adInitialized = 'true';
          root.dataset.adInitialized = 'true';
          initialized = true;
          stats.initializedSlots += 1;
          const rootRect = root.getBoundingClientRect();
          const adRect = ad.getBoundingClientRect();
          stats.lastInitialization = {
            id: root.id,
            rootWidth: rootRect.width,
            rootHeight: rootRect.height,
            adWidth: adRect.width,
            adHeight: adRect.height,
            rootDisplay: window.getComputedStyle(root).display,
            adDisplay: window.getComputedStyle(ad).display,
          };
          (window.adsbygoogle = window.adsbygoogle || []).push({});
          initializing = false;
        });
      }).catch(() => {
        initializing = false;
      });
    });
  };

  if (planner) {
    plannerReady = planner.dataset.plannerReady === 'true';
    const markPlannerInteractive = () => {
      plannerInteractive = true;
      tryInit();
    };
    for (const eventName of ['pointerdown', 'keydown', 'touchstart', 'scroll']) {
      window.addEventListener(eventName, markPlannerInteractive, { once: true, passive: true });
    }
    window.addEventListener('roomfeng:planner-ready', () => {
      plannerReady = true;
      tryInit();
    }, { once: true });
  }

  if ('IntersectionObserver' in window) {
    const visibilityObserver = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) tryInit();
    }, { rootMargin: '500px 0px' });
    visibilityObserver.observe(root);
  } else {
    scheduleIdle(tryInit);
  }
  if ('ResizeObserver' in window) new ResizeObserver(tryInit).observe(root);
  tryInit();
})();
`;
---

{adUnitSlot && adsenseClient && (
  <aside class="ad-slot" id={id} data-ad-slot={adUnitSlot} aria-label="Advertisement">
    <ins
      class="adsbygoogle"
      style="display:block;width:100%;min-width:1px"
      data-ad-client={adsenseClient}
      data-ad-slot={adUnitSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline set:html={adSlotScript} />
  </aside>
)}
