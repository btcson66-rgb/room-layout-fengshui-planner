---
interface Props {
  title: string;
  description: string;
  canonical: string;
  lang: 'zh' | 'en';
  ogImage?: string;
  ogType?: string;
  alternates?: {
    zh: string;
    en: string;
    xDefault?: string;
  };
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const { title, description, canonical, lang, ogImage, ogType = 'website', alternates, jsonLd, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://roomfeng.win');
const url = new URL(canonical, site).toString();
const imageUrl = new URL(ogImage ?? '/og-image.png', site).toString();
const logoUrl = new URL('/apple-touch-icon.png', site).toString();
const siteOrigin = site.toString().replace(/\/$/, '');
const gaId = import.meta.env.PUBLIC_GA_ID?.trim();
// The shared loader must use the site's verified GA4 stream.  The affiliate
// destination is event-level only (see affiliateAnalytics.ts); configuring it
// here makes gtag.js attempt a second loader request, and an unavailable
// affiliate stream can be returned as HTML and blocked by ORB.  Production
// supplies PUBLIC_GA_ID (G-9SCRT8E036); when it is absent we keep analytics
// disabled rather than inventing a loader destination.
const loaderGaId = gaId;
const googleTagConfigs = [
  gaId ? `gtag('config', '${gaId}');` : '',
].filter(Boolean).join('\n');
const analyticsScript = [
  'window.dataLayer = window.dataLayer || [];',
  'window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };',
  'window.__RF_PRODUCT_002_ANALYTICS_ENABLED__ = window.__RF_PRODUCT_002_ANALYTICS_ENABLED__ === true;',
  "gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });",
  `window.__roomfengLoadGoogleTag = window.__roomfengLoadGoogleTag || function () {
    if (!window.__roomfengGoogleTagConfigured) {
      window.__roomfengGoogleTagConfigured = true;
      gtag('js', new Date());
      ${googleTagConfigs}
    }
    if (window.__roomfengGoogleTagPromise) return window.__roomfengGoogleTagPromise;
    var existing = document.querySelector('script[data-roomfeng-google-tag]');
    window.__roomfengGoogleTagPromise = new Promise(function (resolve, reject) {
      if (existing) {
        existing.addEventListener('load', function () { window.__roomfengGoogleTagLoaded = true; resolve(); }, { once: true });
        existing.addEventListener('error', reject, { once: true });
        return;
      }
      var script = document.createElement('script');
      script.async = true;
      script.dataset.roomfengGoogleTag = 'true';
      script.src = 'https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(loaderGaId)}';
      script.onload = function () { window.__roomfengGoogleTagLoaded = true; resolve(); };
      script.onerror = function () { reject(new Error('google-tag-load-failed')); };
      document.head.appendChild(script);
    });
    return window.__roomfengGoogleTagPromise;
  };`,
  "var savedConsent = null; try { savedConsent = window.localStorage.getItem('btcson_consent_v1'); } catch (error) {}",
  "if (savedConsent === 'accepted') { window.__RF_PRODUCT_002_ANALYTICS_ENABLED__ = true; gtag('consent', 'update', { analytics_storage: 'granted' }); window.__roomfengLoadGoogleTag(); }",
  `(() => {
    const initConsentUi = () => {
      if (document.querySelector('[data-consent-widget]')) return;
      const isZh = (document.documentElement.lang || '').toLowerCase().startsWith('zh');
      const widget = document.createElement('div');
      widget.setAttribute('data-consent-widget', '');
      widget.style.cssText = 'position:fixed;right:16px;bottom:16px;z-index:1000;max-width:min(440px,calc(100vw - 32px));color:#172033;font-family:inherit';
      widget.innerHTML = isZh
        ? '<section role="dialog" aria-labelledby="consent-title" aria-describedby="consent-description" style="display:grid;gap:12px;padding:16px;border:1px solid #cbd5e1;border-radius:12px;background:#fff;box-shadow:0 8px 28px rgb(15 23 42 / 18%)"><div><h2 id="consent-title" style="margin:0 0 6px;font-size:1rem">分析與 Cookie 選擇</h2><p id="consent-description" style="margin:0;font-size:.875rem;line-height:1.5">我們使用必要技術維持網站運作；只有在你選擇接受後，才啟用分析儲存。你可以隨時重新修改選擇。</p></div><div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end"><button type="button" data-consent-action="reject">拒絕分析</button><button type="button" data-consent-action="accept" style="border-color:#0f766e;background:#0f766e;color:#fff">接受分析</button></div></section><button type="button" data-consent-action="settings" hidden style="display:block;margin-left:auto;min-height:36px;padding:8px 12px;border:1px solid #94a3b8;border-radius:8px;background:#fff;color:inherit;cursor:pointer;font:inherit;font-weight:700">Cookie 設定</button>'
        : '<section role="dialog" aria-labelledby="consent-title" aria-describedby="consent-description" style="display:grid;gap:12px;padding:16px;border:1px solid #cbd5e1;border-radius:12px;background:#fff;box-shadow:0 8px 28px rgb(15 23 42 / 18%)"><div><h2 id="consent-title" style="margin:0 0 6px;font-size:1rem">Analytics and cookie choices</h2><p id="consent-description" style="margin:0;font-size:.875rem;line-height:1.5">We use essential technology to keep this site working. Analytics storage is enabled only after you choose to accept it. You can change your choice at any time.</p></div><div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end"><button type="button" data-consent-action="reject">Reject analytics</button><button type="button" data-consent-action="accept" style="border-color:#0f766e;background:#0f766e;color:#fff">Accept analytics</button></div></section><button type="button" data-consent-action="settings" hidden style="display:block;margin-left:auto;min-height:36px;padding:8px 12px;border:1px solid #94a3b8;border-radius:8px;background:#fff;color:inherit;cursor:pointer;font:inherit;font-weight:700">Cookie settings</button>';
      const banner = widget.firstElementChild;
      const settings = widget.lastElementChild;
      const readChoice = () => {
        try {
          const choice = window.localStorage.getItem('btcson_consent_v1');
          return choice === 'accepted' || choice === 'rejected' ? choice : null;
        } catch { return null; }
      };
      const render = () => {
        const choice = readChoice();
        banner.hidden = Boolean(choice);
        banner.style.display = choice ? 'none' : 'grid';
        settings.hidden = !choice;
        settings.style.display = choice ? 'block' : 'none';
      };
      widget.addEventListener('click', (event) => {
        const action = event.target.closest('[data-consent-action]')?.getAttribute('data-consent-action');
        if (action === 'settings') { banner.hidden = false; banner.style.display = 'grid'; settings.hidden = true; settings.style.display = 'none'; return; }
        if (action !== 'accept' && action !== 'reject') return;
        const choice = action === 'accept' ? 'accepted' : 'rejected';
        try { window.localStorage.setItem('btcson_consent_v1', choice); } catch {}
        window.__RF_PRODUCT_002_ANALYTICS_ENABLED__ = choice === 'accepted';
        window.gtag('consent', 'update', { analytics_storage: choice === 'accepted' ? 'granted' : 'denied' });
        if (choice === 'accepted') window.__roomfengLoadGoogleTag?.();
        render();
      });
      document.body.appendChild(widget);
      render();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initConsentUi, { once: true });
    else initConsentUi();
  })();`,
].filter(Boolean).join('\n');
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || import.meta.env.PUBLIC_ADSENSE_ID;
const locale = lang === 'zh' ? 'zh_TW' : 'en_US';
const alternateLinks = alternates
  ? [
      { lang: 'zh', href: alternates.zh },
      { lang: 'en', href: alternates.en },
      { lang: 'x-default', href: alternates.xDefault ?? alternates.zh },
    ]
  : [];
const organizationLogo = {
  '@type': 'ImageObject',
  url: logoUrl,
  width: 180,
  height: 180,
};
const organization = {
  '@type': 'Organization',
  name: 'RoomFeng',
  url: siteOrigin,
  logo: organizationLogo,
};
const withStructuredDataDefaults = (item: Record<string, unknown>) => {
  const rawType = item['@type'];
  const types = Array.isArray(rawType) ? rawType : [rawType];

  if (types.includes('Article')) {
    return {
      image: imageUrl,
      author: organization,
      publisher: organization,
      ...item,
    };
  }

  if (types.includes('Organization')) {
    return {
      ...item,
      logo: item.logo ?? organizationLogo,
    };
  }

  return item;
};
const jsonItems = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map(withStructuredDataDefaults);
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={url} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content="RoomFeng" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{alternateLinks.map((alt) => <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, site).toString()} />)}
{jsonItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
{loaderGaId && (
  <>
    <script is:inline set:html={analyticsScript} />
  </>
)}
{/* AdSense 網站擁有權驗證。主控台在無法執行 loader script 時改讀這個 meta，
    它本身不發出廣告請求。條件與 loader 相同：noindex 頁一律不輸出。 */}
{!noindex && adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}
{!noindex && adsenseClient && (
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous" />
)}
