---
import Layout from './Layout.astro';
import { bedroomBedRows, type GuidePageData } from '../us-seo/content';
import { renderFloorPlanSvg } from '../us-seo/renderer';
import '../styles/us-seo.css';

interface Props {
  data: GuidePageData;
}

const { data } = Astro.props;
const siteUrl = 'https://roomfeng.win';
const isBedroom = data.plans[0]?.unit === 'in';
const bedRows = isBedroom ? bedroomBedRows(data.plans[0].roomWidth, data.plans[0].roomLength) : [];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: data.title,
    description: data.description,
    url: `${siteUrl}${data.path}`,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: data.h1, item: `${siteUrl}${data.path}` },
    ],
  },
  faqJsonLd,
];
const squareFootNote = data.footprintNote;
---

<Layout title={data.title} description={data.description} canonical={data.path} lang="en" jsonLd={jsonLd} pageType="guide">
  <section class="us-seo-page">
    <div class="container">
      <header class="us-seo-hero">
        <p class="us-seo-kicker">RoomFeng / measured layout guide</p>
        <h1>{data.h1}</h1>
        <p class="lead">{data.lead}</p>
        {squareFootNote && <p class="us-seo-caution"><strong>Illustrative layout study:</strong> {squareFootNote} Square footage alone does not tell you the usable furniture area.</p>}
      </header>

      <section class="us-seo-section" aria-labelledby="quick-answer-heading">
        <h2 id="quick-answer-heading">Quick answer</h2>
        <p class="us-seo-answer">{data.quickAnswer}</p>
        <div class="us-seo-math">
          {data.math.slice(0, 3).map((item) => <div><p>{item}</p></div>)}
        </div>
      </section>

      {isBedroom && (
        <section class="us-seo-section" aria-labelledby="bed-size-heading">
          <h2 id="bed-size-heading">Common mattress dimensions and room fit</h2>
          <p>These are common U.S. mattress dimensions. Actual bed frames may be larger, so measure the outside dimensions of the frame before purchasing. “Physical fit” below means the mattress rectangle fits in at least one orientation; it does not certify daily comfort or a code requirement.</p>
          <div class="us-seo-table-wrap">
            <table class="us-seo-table">
              <thead><tr><th>Bed size</th><th>Reference size</th><th>Physical fit</th><th>Access planning note</th></tr></thead>
              <tbody>{bedRows.map((row) => <tr><th scope="row">{row.name}</th><td>{row.dimensions}</td><td>{row.physicalFit}</td><td>{row.accessNote}</td></tr>)}</tbody>
            </table>
          </div>
        </section>
      )}

      <section class="us-seo-section" aria-labelledby="assumptions-heading">
        <h2 id="assumptions-heading">Exact assumptions</h2>
        <ul class="us-seo-list">{data.assumptions.map((item) => <li>{item}</li>)}</ul>
        {data.math.length > 3 && <><h3>Room math</h3><ul class="us-seo-list">{data.math.map((item) => <li>{item}</li>)}</ul></>}
      </section>

      <section class="us-seo-section" aria-labelledby="layouts-heading">
        <h2 id="layouts-heading">Layout options with proportional diagrams</h2>
        <p>Each diagram is a top-down planning study. The rectangles are drawn from the stated room and furniture footprints; replace the assumptions with your measured doors, windows, frames and fixed elements before buying.</p>
        <div class="us-seo-diagram-grid">
          {data.plans.map((plan) => <figure class="us-seo-diagram"><div set:html={renderFloorPlanSvg(plan)}></div><figcaption><strong>{plan.title}.</strong> {plan.description}</figcaption></figure>)}
        </div>
      </section>

      <section class="us-seo-section" aria-labelledby="compatibility-heading">
        <h2 id="compatibility-heading">Furniture compatibility and clearance</h2>
        <div class="us-seo-table-wrap">
          <table class="us-seo-table">
            <thead><tr><th>Item</th><th>What to check</th></tr></thead>
            <tbody>{data.compatibility.map((item) => <tr><th scope="row">{item.item}</th><td>{item.guidance}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="us-seo-caution">A physical fit is not the same as comfortable use. Check daily access, chair pullback, drawer and door operation, the main walkway, and the route to the entrance. No number on this page is a legal minimum or building-code certification.</p>
      </section>

      <section class="us-seo-section" aria-labelledby="mistakes-heading">
        <h2 id="mistakes-heading">Mistakes to avoid</h2>
        <ul class="us-seo-list">{data.mistakes.map((item) => <li>{item}</li>)}</ul>
        <h2>What to measure next</h2>
        <ol class="us-seo-list">{data.measureNext.map((item) => <li>{item}</li>)}</ol>
      </section>

      <section class="cta-band" aria-label="Next planning step">
        <div><h2>Test your measured room</h2><p>Use the free planner after replacing the reference dimensions with the real outside dimensions of your furniture and openings.</p></div>
        <a class="button" href={data.ctaHref ?? '/en/room-layout-planner/'}>{data.ctaLabel ?? 'Open the RoomFeng Room Planner'}</a>
      </section>

      <section class="us-seo-section us-seo-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        {data.faq.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}
      </section>

      <nav class="us-seo-section us-seo-related" aria-labelledby="related-heading">
        <h2 id="related-heading">Related RoomFeng pages</h2>
        <ul>{data.related.map((link) => <li><a href={link.href}>{link.title}</a></li>)}</ul>
      </nav>
    </div>
  </section>
</Layout>
