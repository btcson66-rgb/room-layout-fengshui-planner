---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  lang?: 'zh' | 'en';
}

const { items, lang = (Astro.currentLocale === 'en' || Astro.url.pathname.startsWith('/en/')) ? 'en' : 'zh' } = Astro.props;
const heading = lang === 'en' ? 'Frequently asked questions' : '常見問題';
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section data-roomfeng-component="faq" data-locale={lang} aria-labelledby="faq-heading">
  <h2 id="faq-heading">{heading}</h2>
  <div class="faq-list">
    {items.map((item) => (
      <article class="faq-item">
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </article>
    ))}
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
