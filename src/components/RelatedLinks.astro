---
import internalLinks from '../data/internal-links.json';

interface RelatedLink {
  href: string;
  title: string;
}

interface Props {
  links?: RelatedLink[];
  lang?: 'zh' | 'en';
  path?: string;
  max?: number;
}

const { links = [], path, max = 6, lang = (Astro.currentLocale === 'en' || Astro.url.pathname.startsWith('/en/')) ? 'en' : 'zh' } = Astro.props;
const heading = lang === 'en' ? 'Related pages' : '相關頁面';
const graph = internalLinks as Record<string, { url: string; anchor: string }[]>;
const graphLinks = path ? (graph[path.endsWith('/') ? path : `${path}/`] ?? []) : [];
const seen = new Set(links.map((link) => link.href));
// 既有內容契約：每篇文章最多 5 個文章連結，還要保留 Hub 與工具入口。
// 圖譜只補剩下的文章名額，不把 related-links 變成十幾條的連結牆。
const articleSlots = Math.max(0, Math.min(max, 5 - links.filter((link) => link.href.startsWith('/zh/blog/')).length));
const selectedGraphLinks: RelatedLink[] = [];
for (const link of graphLinks) {
  if (selectedGraphLinks.length >= articleSlots) break;
  if (!link.url.startsWith('/zh/blog/') || seen.has(link.url)) continue;
  seen.add(link.url);
  selectedGraphLinks.push({ href: link.url, title: link.anchor });
}
const allLinks = [...links, ...selectedGraphLinks];
---

<nav class="related-links" data-roomfeng-component="related-links" data-locale={lang} aria-labelledby="related-heading">
  <h2 id="related-heading">{heading}</h2>
  <ul>
    {allLinks.map((link) => <li><a href={link.href}>{link.title}</a></li>)}
  </ul>
</nav>
