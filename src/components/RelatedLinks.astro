---
interface RelatedLink {
  href: string;
  title: string;
}

interface Props {
  links: RelatedLink[];
  lang?: 'zh' | 'en';
}

const { links, lang = (Astro.currentLocale === 'en' || Astro.url.pathname.startsWith('/en/')) ? 'en' : 'zh' } = Astro.props;
const heading = lang === 'en' ? 'Related pages' : '相關頁面';
---

<nav class="related-links" data-roomfeng-component="related-links" data-locale={lang} aria-labelledby="related-heading">
  <h2 id="related-heading">{heading}</h2>
  <ul>
    {links.map((link) => <li><a href={link.href}>{link.title}</a></li>)}
  </ul>
</nav>
