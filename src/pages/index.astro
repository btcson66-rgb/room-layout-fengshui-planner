---
import Layout from '../components/Layout.astro';
import Faq from '../components/Faq.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import PlannerCta from '../components/PlannerCta.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { AFFILIATE_POLICY_LINE } from '../config/affiliate';
import { reviewReadyCategorySlugs } from '../data/contentQuality.mjs';
import { hubContent } from '../data/hubs';
import { categoryMeta, siteUrl } from '../data/site';

// 首頁刻意不再列「最新文章」。自動抓最新更新只會把首頁的內部連結權重
// 灑到隨機的長尾頁面上，也讓首頁看起來像文章牆。改成連到 9 個主題 Hub
// 與人工挑選的核心指南，讓 Google 從首頁就讀到「這個站分成哪些主題」。
const hubs = Object.entries(categoryMeta)
  .filter(([slug]) => reviewReadyCategorySlugs.has(slug) && hubContent[slug])
  .map(([slug, meta]) => ({ href: `/zh/category/${slug}/`, title: meta.title, description: meta.description }));
const keyGuides = [
  { href: '/zh/blog/room-circulation-width-guide/', title: '房間走道要留多寬', text: '整站被引用最多的一篇：用門片、抽屜與椅子的實際尺寸反推走道，而不是背一個數字。' },
  { href: '/zh/blog/bed-size-room-guide/', title: '床尺寸怎麼選', text: '先量走道再挑床。附台灣床墊尺寸對照與床架外框加值表。' },
  { href: '/zh/blog/bed-facing-door-feng-shui/', title: '床對門怎麼處理', text: '床頭對門與床尾對門要分開判斷，先看開門視線與實牆位置。' },
  { href: '/zh/blog/beam-over-desk-bed-layout/', title: '橫樑壓床完整指南', text: '床型、床邊家具、靠窗與租屋不能移床，全部收在同一頁。' },
  { href: '/zh/blog/tiny-room-layout-under-5-ping/', title: '5 坪以下房間怎麼設計', text: '先算扣掉樑柱與門片的淨尺寸，再分配床、桌與收納。' },
  { href: '/zh/blog/small-room-storage-zones/', title: '小房間收納分區', text: '先盤點 30 件常用物品，再規劃五個存放區，不要先買收納盒。' },
];
const title = 'RoomFeng｜免費房間規劃與風水佈局工具';
const description = '輸入房間尺寸、門窗位置與家具需求，快速取得臥室、小房間、小套房與書桌配置建議，並參考床位、鏡子、採光、收納與動線風水提醒。';
const canonical = '/';
const alternates = { zh: '/', en: '/en/' };
const faq = [
  { q: '房間規劃工具可以做什麼？', a: '可以協助你整理房間尺寸、門窗位置、家具需求、動線、採光、收納與風水參考，適合搬家、租屋與買家具前使用。' },
  { q: '風水建議是保證有效嗎？', a: '不是。本站風水內容只作為傳統文化與室內配置參考，不保證任何財運、感情、健康或人生結果。' },
  { q: '小房間也能使用嗎？', a: '可以。小房間與小套房更需要先確認床、桌、衣櫃與主要走道，避免家具放得下卻不好用。' },
  { q: '租屋不能裝潢也可以改善嗎？', a: '可以。可先用家具位置、布簾、床頭板、矮櫃、收納盒與燈光做可復原調整。' },
  { q: '需要註冊才能使用嗎？', a: '不需要。本站以靜態網站與瀏覽器端工具為主，不需要資料庫或帳號。' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RoomFeng',
    url: `${siteUrl}/`,
    inLanguage: 'zh-TW',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'RoomFeng',
    url: siteUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}/` },
    ],
  },
];
const tools = [
  { href: '/zh/room-layout-planner/', title: '房間規劃工具', text: '輸入房間尺寸、門窗與家具需求，取得配置、動線、採光與收納提醒。' },
  { href: '/zh/small-room-storage-planner/', title: '小房間收納規劃器', text: '輸入坪數或房間長寬、床型與衣櫃條件，估算剩餘空間並取得收納方案。' },
  { href: '/zh/room-furniture-size-advisor/', title: '房間傢俱尺寸建議器', text: '依房間長寬建議床、書桌與衣櫃尺寸，並用 60 公分原則試算走道。' },
  { href: '/zh/bed-desk-wardrobe-layout/', title: '臥室配置工具', text: '檢查床、門、窗、衣櫃與書桌的配置順序與睡眠舒適度。' },
  { href: '/zh/small-bedroom-layout/', title: '小房間配置工具', text: '針對小房間、小套房與租屋情境整理收納和多功能家具建議。' },
  { href: '/zh/feng-shui-bedroom-checker/', title: '臥室風水檢查工具', text: '用 checklist 參考床對門、鏡子對床、床頭靠窗與動線問題。' },
  { href: '/zh/bed-door-fix-selector/', title: '床對門化解方案選擇器', text: '輸入床位、房間尺寸與可移動程度，依可行性排序化解做法並附最小尺寸。' },
  { href: '/zh/room-size-layout-templates/', title: '坪數房間配置範本庫', text: '選坪數與需求組合，取得 2-3 個可行配置、走道寬度與常見錯誤提醒。' },
  { href: '/zh/desk-placement-feng-shui/', title: '書桌擺放參考', text: '檢查自然光、插座、椅子後方空間與書桌風水參考。' },
];
const audiences = ['租屋族', '學生', '小房間使用者', '搬家前規劃', '想改善床位與收納的人', '想參考房間風水的人'];
const problems = ['床不知道怎麼擺', '小房間太擠', '書桌採光不好', '衣櫃擋住動線', '鏡子對床', '床對門', '房間收納混亂'];
---

<Layout title={title} description={description} canonical={canonical} lang="zh" alternates={alternates} jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <header class="home-hero">
        <div class="home-hero-copy">
          <p class="eyebrow">MEASURE · PLAN · CHECK</p>
          <h1>先確認放不放得下，再搬、再買。</h1>
          <p class="lead">RoomFeng 先把房間內徑、門窗與家具外框放進同一張平面圖，再檢查動線與操作空間。把「看起來放得下」變成「每天用起來順」。</p>
          <div class="cta-row">
            <a class="button" href="/zh/room-layout-planner/">開始畫房間平面圖 <span aria-hidden="true">↗</span></a>
            <a class="button secondary" href="/zh/furniture-fit-checker/">先檢查家具尺寸</a>
          </div>
          <p class="hero-note"><span aria-hidden="true">●</span> 免費使用 · 不需註冊 · 草稿留在你的瀏覽器</p>
        </div>
          <div class="hero-plan" aria-label="360 x 300 公分房間，150 x 190 公分床，120 x 60 公分書桌，床尾 72 公分淨空帶與 80 公分門片開啟範圍">
          <span class="hero-plan-label">A MEASURED PLAN</span>
          <svg viewBox="0 0 360 300" role="img" aria-hidden="true">
            <rect class="plan-room" x="0" y="0" width="360" height="300" />
            <path class="plan-door" d="M0 220h80M0 220a80 80 0 0 1 80 80" />
            <rect class="plan-bed" x="34" y="28" width="150" height="190" rx="3" />
            <rect class="plan-clearance-band" x="34" y="218" width="150" height="72" rx="2" />
            <rect class="plan-pillow" x="42" y="36" width="134" height="28" rx="3" />
            <rect class="plan-desk" x="220" y="34" width="120" height="60" rx="3" />
            <rect class="plan-wardrobe" x="260" y="174" width="80" height="55" rx="3" />
            <path class="plan-route" d="M84 270c48-25 82-29 126-18s74 6 105-33" />
            <text x="180" y="16">ROOM 360 × 300 cm</text>
            <text x="109" y="132">BED 150 × 190</text><text x="280" y="68">DESK 120 × 60</text><text x="300" y="204">STORAGE</text>
            <text class="plan-measurement" x="109" y="257">CLEARANCE BAND 72 cm</text><text class="plan-measurement" x="45" y="238">DOOR 80 cm</text>
          </svg>
          <span class="hero-plan-caption">先量尺寸，再決定家具怎麼走、怎麼放。</span>
        </div>
        <ol class="how-it-works" aria-label="使用步驟">
          <li><span>01</span><strong>Measure 量尺寸</strong><small>房間、門窗、家具外框</small></li>
          <li><span>02</span><strong>Plan 排配置</strong><small>放置、旋轉、調整尺寸</small></li>
          <li><span>03</span><strong>Check 看結果</strong><small>動線、開門與匯出報告</small></li>
        </ol>
      </header>

      <section class="measurement-ribbon" aria-labelledby="measurement-heading">
        <div>
          <p class="eyebrow">THE CORE QUESTION</p>
          <h2 id="measurement-heading">先確認放不放得下，再談風格。</h2>
        </div>
        <p>尺寸、門片、家具外框與每天會走的路，是 RoomFeng 的第一層答案。中文站的風水內容則放在完成測量後，作為次要的民俗文化與舒適度參考。</p>
      </section>

      <section class="home-section tools-section" aria-labelledby="tools-heading">
        <div class="section-heading"><div><p class="eyebrow">START HERE</p><h2 id="tools-heading">先從一個明確問題開始</h2></div><span class="section-count">09 tools</span></div>
        <div class="tool-primary">
          <article class="tool-card-main">
            <div class="tool-card-index">01 · FEATURED TOOL</div>
            <h3><a href="/zh/room-layout-planner/">拖拉式房間平面圖工具 <span aria-hidden="true">↗</span></a></h3>
            <p>輸入房間尺寸，拖曳床、書桌、衣櫃、沙發、門、窗與鏡子，檢查動線、門口與走道寬度，再匯出 PNG 或 PDF。</p>
            <a class="button" href="/zh/room-layout-planner/">立即使用</a>
          </article>
        </div>
        <div class="scenario-grid">
          {tools.map((tool, index) => (
            <article class="tool-card">
              <span class="tool-card-index">{String(index + 2).padStart(2, '0')}</span>
              <h3><a href={tool.href}>{tool.title} <span aria-hidden="true">↗</span></a></h3>
              <p>{tool.text}</p>
            </article>
          ))}
        </div>
      </section>

      <NewsletterSignup placement="home" />

      <section class="card split-section" aria-labelledby="audience-heading">
        <div>
          <p class="eyebrow">A BETTER STARTING POINT</p><h2 id="audience-heading">為正在做決定的人整理</h2>
          <ul>{audiences.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h2>可以解決哪些問題</h2>
          <ul>{problems.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <section class="card editorial-section" aria-labelledby="how-heading">
        <h2 id="how-heading">Room Planner 怎麼用</h2>
        <ol class="how-steps">
          <li><strong>量三件事</strong>：房間內徑長寬、門片開啟方向與寬度、窗戶位置。有橫樑時再加樑的兩條投影線。</li>
          <li><strong>拖進家具</strong>：床、書桌、衣櫃、沙發、門、窗、鏡子都可以旋轉與改尺寸，數字直接以公分輸入。</li>
          <li><strong>看警示</strong>：工具會標出家具超出房間、門口被擋住、主要走道低於 60 公分，中文版另有床對門、鏡子對床、床頭無支撐等民俗參考提醒。</li>
          <li><strong>匯出</strong>：存成 PNG 或 PDF，買家具、搬家或跟房東溝通時直接拿出來對。</li>
        </ol>
        <p class="muted">全部在瀏覽器裡運算，不需要註冊、沒有資料庫，草稿存在你自己的瀏覽器裡。</p>
      </section>

      <PlannerCta
        preset="double"
        heading="直接載入一個範例房間試試"
        text="不想從空白開始的話，可以先載入雙人房範例，把尺寸改成你家的數字，再拖動床與衣櫃看警示怎麼變。"
      />

      <section class="card editorial-section" aria-labelledby="hub-heading">
        <h2 id="hub-heading">主題入口</h2>
        <p>RoomFeng 的內容分成這幾個主題，每一個都有導讀、核心問題、精選指南與對應工具。</p>
        <div class="scenario-grid">
           {hubs.map((hub) => (
            <article>
              <h3><a href={hub.href}>{hub.title}</a></h3>
              <p>{hub.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card editorial-section" aria-labelledby="guides-heading">
        <h2 id="guides-heading">最值得先讀的指南</h2>
        <p>這幾篇是人工挑選的核心指南，不是依更新時間自動排出來的清單。</p>
        <div class="post-list">
          {keyGuides.map((guide) => (
            <article>
              <h3><a href={guide.href}>{guide.title}</a></h3>
              <p>{guide.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card editorial-section" aria-labelledby="editorial-heading">
        <h2 id="editorial-heading">RoomFeng 如何整理公開指南</h2>
        <p>本站不以大量短文覆蓋相似搜尋詞。未達公開標準的內容不會列入文章清單與搜尋索引；只有完成實際尺寸檢查流程、可執行案例、限制說明、站內工具驗證與人工編輯的指南才會公開。</p>
        <ul>
          <li>先量房間、門窗、插座與家具外徑，再寫配置結論。</li>
          <li>數字只作規劃起點，不能取代建築、消防、無障礙或專業設計規範。</li>
          <li>風水只分開標示為民俗文化參考，不包裝成健康或人生結果。</li>
          <li>{AFFILIATE_POLICY_LINE}</li>
          <li>相似搜尋詞不另開新頁，一律併進同一篇完整指南的不同段落；合併掉的舊網址以 301 轉到最相關的指南。</li>
        </ul>
        <p>內容方法、作者說明與更正方式可查看 <a href="/about/#editorial-process">編輯與審查流程</a>。</p>
      </section>
      <Faq lang="zh" items={faq} />
      <RelatedLinks lang="zh" links={[
        { href: '/zh/room-layout-planner/', title: '拖拉式房間平面圖工具' },
        { href: '/zh/blog/', title: '房間規劃文章' },
        { href: '/zh/feng-shui-bedroom-checker/', title: '臥室風水檢查工具' },
        { href: '/zh/small-bedroom-layout/', title: '小房間配置工具' },
        { href: '/zh/desk-placement-feng-shui/', title: '書桌擺放參考' },
        { href: '/zh/furniture-fit-checker/', title: '家具尺寸檢查' },
      ]} />
    </div>
  </section>
</Layout>

<style>
  .how-steps { display: grid; gap: var(--space-3); margin: 0 0 var(--space-3); padding-left: 1.2rem; }
  .muted { color: var(--color-muted); font-size: var(--text-sm); }
  .home-hero {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.35rem, 5vw, 4.5rem) 0;
    border-block: 1px solid var(--color-border);
    background: transparent;
  }

  .home-hero-copy { position: relative; z-index: 1; }
  .home-hero h1 { max-width: 10ch; }
  .home-hero .lead { max-width: 58ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .hero-note { margin: var(--space-4) 0 0; color: var(--color-muted); font-size: var(--text-sm); }
  .hero-note span { color: var(--color-sage); font-size: 0.65rem; vertical-align: 0.1em; }

  .hero-plan {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 290px;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    overflow: hidden;
  }
  .hero-plan::before { position: absolute; content: 'N  01'; top: 0.8rem; right: 1rem; color: var(--color-muted); font-size: 0.68rem; letter-spacing: 0.12em; }
  .hero-plan-label { position: absolute; top: 0.8rem; left: 1rem; color: var(--color-primary-strong); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.12em; }
  .hero-plan svg { width: min(100%, 420px); margin-inline: auto; }
  .hero-plan .plan-room { fill: var(--color-surface-strong); stroke: var(--color-primary-strong); stroke-width: 2; }
  .hero-plan .plan-door, .hero-plan .plan-route { fill: none; stroke: var(--color-accent); stroke-width: 2; }
  .hero-plan .plan-route { stroke: var(--color-sage); stroke-dasharray: 5 6; }
  .hero-plan .plan-bed { fill: #dce8e1; stroke: var(--color-primary-strong); stroke-width: 1.5; }
  .hero-plan .plan-pillow { fill: #f7faf8; stroke: #b7c9bf; }
  .hero-plan .plan-desk { fill: #e5ece8; stroke: var(--color-sage); stroke-width: 1.5; }
  .hero-plan .plan-wardrobe { fill: #ecebe3; stroke: var(--color-accent); stroke-width: 1.5; }
  .hero-plan text { fill: var(--color-muted); font-size: 9px; font-weight: 800; letter-spacing: 0.04em; text-anchor: middle; }
  .hero-plan .plan-measurement { fill: var(--color-primary-strong); font-size: 8px; }
  .hero-plan-caption { display: block; max-width: 27rem; margin: -0.5rem auto 0; color: var(--color-muted); font-family: var(--font-sans); font-size: var(--text-lg); line-height: 1.25; text-align: center; }

  .measurement-ribbon { display: grid; gap: var(--space-4); align-items: start; padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); }
  .measurement-ribbon h2 { margin: 0; }
  .measurement-ribbon p:last-child { max-width: 62ch; margin: 0; color: var(--color-muted); }

  .how-it-works { display: grid; gap: 0; padding: 0; margin: 0; border-top: 1px solid var(--color-border); list-style: none; }
  .how-it-works li { display: grid; grid-template-columns: auto 1fr; column-gap: 0.75rem; padding: 0.85rem 0; border-bottom: 1px solid var(--color-border); }
  .how-it-works li > span { grid-row: span 2; color: var(--color-primary); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.08em; }
  .how-it-works strong { font-size: var(--text-sm); }
  .how-it-works small { color: var(--color-muted); font-size: var(--text-sm); }

  .home-section { padding-block: var(--space-5); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-5); }
  .section-heading h2 { margin: 0; }
  .section-count { margin-bottom: 0.25rem; color: var(--color-muted); white-space: nowrap; }
  .tool-primary { margin-bottom: var(--space-4); }
  .tool-card-main { display: grid; gap: var(--space-3); padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--color-primary); border-left: 6px solid var(--color-primary); background: var(--color-primary-soft); }
  .tool-card-main h3 { font-family: var(--font-sans); font-size: clamp(1.4rem, 1.15rem + 0.7vw, 2rem); }
  .tool-card-main .button { justify-self: start; }
  .scenario-grid, .post-list { display: grid; gap: 0; border-top: 1px solid var(--color-border); }
  .tool-card, .post-list article { min-height: 100%; padding: var(--space-4) 0; border-bottom: 1px solid var(--color-border); }
  .tool-card { display: grid; gap: 0.35rem; }
  .tool-card h3 { margin-bottom: 0; }
  .tool-card h3 a, .post-list h3 a { color: var(--color-text); text-decoration: none; }
  .tool-card h3 a:hover, .post-list h3 a:hover { color: var(--color-primary-strong); text-decoration: underline; text-decoration-thickness: 2px; }
