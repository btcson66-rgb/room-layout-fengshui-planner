---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import Faq from '../components/Faq.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { isReviewReadyBlogSlug } from '../data/contentQuality.mjs';
import { categoryMeta, formatDate, siteUrl } from '../data/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.noindex && isReviewReadyBlogSlug(post.id))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const latestPosts = posts.slice(0, 5);
const popularPosts = posts.filter((post) => ['feng-shui', 'room-planning', 'small-room'].includes(post.data.category)).slice(0, 6);
const title = 'RoomFeng｜免費房間規劃與風水佈局工具';
const description = '輸入房間尺寸、門窗位置與家具需求，快速取得臥室、小房間、小套房與書桌配置建議，並參考床位、鏡子、採光、收納與動線風水提醒。';
const canonical = '/';
const alternates = { zh: '/', en: '/en/' };
const faq = [
  { q: '房間規劃工具可以做什麼？', a: '可以協助你整理房間尺寸、門窗位置、家具需求、動線、採光、收納與風水參考，適合搬家、租屋與買家具前使用。' },
  { q: '風水建議是保證有效嗎？', a: '不是。本站風水內容只作為傳統文化與室內配置參考，不保證任何財運、感情、健康或人生結果。' },
  { q: '小房間也能使用嗎？', a: '可以。小房間與小套房更需要先確認床、桌、衣櫃與主要走道，避免家具放得下卻不好用。' },
  { q: '租屋不能裝潢也可以改善嗎？', a: '可以。可先用家具位置、布簾、床頭板、矮櫃、收納盒與燈光做可復原調整。' },
  { q: '需要註冊才能使用嗎？', a: '不需要。本站以靜態網站與瀏覽器端工具為主，不需要資料庫或帳號。' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RoomFeng',
    url: `${siteUrl}/`,
    inLanguage: 'zh-TW',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'RoomFeng',
    url: siteUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}/` },
    ],
  },
];
const tools = [
  { href: '/zh/room-layout-planner/', title: '房間規劃工具', text: '輸入房間尺寸、門窗與家具需求，取得配置、動線、採光與收納提醒。' },
  { href: '/zh/small-room-storage-planner/', title: '小房間收納規劃器', text: '輸入坪數或房間長寬、床型與衣櫃條件，估算剩餘空間並取得收納方案。' },
  { href: '/zh/room-furniture-size-advisor/', title: '房間傢俱尺寸建議器', text: '依房間長寬建議床、書桌與衣櫃尺寸，並用 60 公分原則試算走道。' },
  { href: '/zh/bed-desk-wardrobe-layout/', title: '臥室配置工具', text: '檢查床、門、窗、衣櫃與書桌的配置順序與睡眠舒適度。' },
  { href: '/zh/small-bedroom-layout/', title: '小房間配置工具', text: '針對小房間、小套房與租屋情境整理收納和多功能家具建議。' },
  { href: '/zh/feng-shui-bedroom-checker/', title: '臥室風水檢查工具', text: '用 checklist 參考床對門、鏡子對床、床頭靠窗與動線問題。' },
  { href: '/zh/bed-door-fix-selector/', title: '床對門化解方案選擇器', text: '輸入床位、房間尺寸與可移動程度，依可行性排序化解做法並附最小尺寸。' },
  { href: '/zh/room-size-layout-templates/', title: '坪數房間配置範本庫', text: '選坪數與需求組合，取得 2-3 個可行配置、走道寬度與常見錯誤提醒。' },
  { href: '/zh/desk-placement-feng-shui/', title: '書桌擺放參考', text: '檢查自然光、插座、椅子後方空間與書桌風水參考。' },
];
const audiences = ['租屋族', '學生', '小房間使用者', '搬家前規劃', '想改善床位與收納的人', '想參考房間風水的人'];
const problems = ['床不知道怎麼擺', '小房間太擠', '書桌採光不好', '衣櫃擋住動線', '鏡子對床', '床對門', '房間收納混亂'];
const fengShuiQuestions = [
  { href: '/zh/blog/bed-facing-door-feng-shui/', title: '床對門怎麼辦' },
  { href: '/zh/blog/mirror-facing-bed-bedroom/', title: '鏡子對床怎麼辦' },
  { href: '/zh/blog/bed-under-window-solutions/', title: '床頭靠窗怎麼辦：7 晚檢查' },
  { href: '/zh/blog/desk-facing-door-layout/', title: '書桌要怎麼擺' },
  { href: '/zh/blog/bed-head-against-wall/', title: '床頭要不要靠牆' },
];
---

<Layout title={title} description={description} canonical={canonical} lang="zh" alternates={alternates} jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <header class="home-hero">
        <div class="home-hero-copy">
          <p class="eyebrow">ROOM PLANNING · FENG SHUI REFERENCE</p>
          <h1>先把房間畫清楚，再決定怎麼住。</h1>
          <p class="lead">RoomFeng 是免費房間家具配置規劃工具：輸入尺寸、拖曳家具、確認動線與門口，再匯出 PNG 或 PDF。把「看起來放得下」變成「每天用起來順」。</p>
          <div class="cta-row">
            <a class="button" href="/zh/room-layout-planner/">開始畫房間平面圖 <span aria-hidden="true">↗</span></a>
            <a class="button secondary" href="/zh/feng-shui-bedroom-checker/">看臥室檢查表</a>
          </div>
          <p class="hero-note"><span aria-hidden="true">●</span> 免費使用 · 不需註冊 · 草稿留在你的瀏覽器</p>
        </div>
        <div class="hero-plan" aria-label="房間平面圖示意：床、書桌與走道">
          <span class="hero-plan-label">A SIMPLE PLAN</span>
          <svg viewBox="0 0 420 320" role="img" aria-hidden="true">
            <rect class="plan-room" x="34" y="28" width="352" height="260" />
            <path class="plan-door" d="M34 222h56M34 222a56 56 0 0 1 56 56" />
            <rect class="plan-bed" x="76" y="72" width="128" height="78" rx="3" />
            <rect class="plan-pillow" x="84" y="80" width="112" height="22" rx="3" />
            <rect class="plan-desk" x="260" y="76" width="82" height="44" rx="3" />
            <rect class="plan-wardrobe" x="276" y="184" width="72" height="64" rx="3" />
            <path class="plan-route" d="M89 247c48-28 93-29 137-5s74 20 111-26" />
            <text x="92" y="120">BED</text><text x="276" y="101">DESK</text><text x="282" y="220">STORAGE</text>
          </svg>
          <span class="hero-plan-caption">RoomFeng turns measurements into a calmer next step.</span>
        </div>
        <ol class="how-it-works" aria-label="使用步驟">
          <li><span>01</span><strong>設定房間</strong><small>長、寬、單位</small></li>
          <li><span>02</span><strong>拖曳家具</strong><small>放置、旋轉、調尺寸</small></li>
          <li><span>03</span><strong>帶走結果</strong><small>PNG、PDF 與提醒</small></li>
        </ol>
      </header>

      <NewsletterSignup placement="home" />

      <section class="home-section tools-section" aria-labelledby="tools-heading">
        <div class="section-heading"><div><p class="eyebrow">START HERE</p><h2 id="tools-heading">先從一個明確問題開始</h2></div><span class="section-count">09 tools</span></div>
        <div class="tool-primary">
          <article class="tool-card-main">
            <div class="tool-card-index">01 · FEATURED TOOL</div>
            <h3><a href="/zh/room-layout-planner/">拖拉式房間平面圖工具 <span aria-hidden="true">↗</span></a></h3>
            <p>輸入房間尺寸，拖曳床、書桌、衣櫃、沙發、門、窗與鏡子，檢查動線、門口與走道寬度，再匯出 PNG 或 PDF。</p>
            <a class="button" href="/zh/room-layout-planner/">立即使用</a>
          </article>
        </div>
        <div class="scenario-grid">
          {tools.map((tool, index) => (
            <article class="tool-card">
              <span class="tool-card-index">{String(index + 2).padStart(2, '0')}</span>
              <h3><a href={tool.href}>{tool.title} <span aria-hidden="true">↗</span></a></h3>
              <p>{tool.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card split-section" aria-labelledby="audience-heading">
        <div>
          <p class="eyebrow">A BETTER STARTING POINT</p><h2 id="audience-heading">為正在做決定的人整理</h2>
          <ul>{audiences.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h2>可以解決哪些問題</h2>
          <ul>{problems.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <section class="card editorial-section" aria-labelledby="feng-heading">
        <h2 id="feng-heading">熱門風水問題</h2>
        <p>以下內容以「民俗上常見說法」與「室內配置舒適度」角度整理，不保證任何結果。請以實際安全、採光、通風、動線與居住需求為優先，並閱讀 <a href="/disclaimer/">免責聲明</a>。</p>
        <ul>{fengShuiQuestions.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
      </section>

      <section class="card editorial-section" aria-labelledby="latest-heading">
        <h2 id="latest-heading">最新文章</h2>
        <div class="post-list">
          {latestPosts.map((post) => (
            <article>
              <p class="meta">{formatDate(post.data.updated)} · <a href={`/zh/category/${post.data.category}/`}>{categoryMeta[post.data.category]?.title}</a></p>
              <h3><a href={`/zh/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card editorial-section" aria-labelledby="popular-heading">
        <h2 id="popular-heading">熱門教學</h2>
        <div class="post-list">
          {popularPosts.map((post) => (
            <article>
              <p class="meta"><a href={`/zh/category/${post.data.category}/`}>{categoryMeta[post.data.category]?.title}</a></p>
              <h3><a href={`/zh/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card editorial-section" aria-labelledby="editorial-heading">
        <h2 id="editorial-heading">RoomFeng 如何整理公開指南</h2>
        <p>本站不以大量短文覆蓋相似搜尋詞。未達公開標準的內容不會列入文章清單與搜尋索引；只有完成實際尺寸檢查流程、可執行案例、限制說明、站內工具驗證與人工編輯的指南才會公開。</p>
        <ul>
          <li>先量房間、門窗、插座與家具外徑，再寫配置結論。</li>
          <li>數字只作規劃起點，不能取代建築、消防、無障礙或專業設計規範。</li>
          <li>風水只分開標示為民俗文化參考，不包裝成健康或人生結果。</li>
          <li>商品與聯盟推薦在 AdSense 重新審查期間預設關閉。</li>
        </ul>
        <p>內容方法、作者說明與更正方式可查看 <a href="/about/#editorial-process">編輯與審查流程</a>。</p>
      </section>
      <Faq items={faq} />
      <RelatedLinks links={[
        { href: '/zh/room-layout-planner/', title: '拖拉式房間平面圖工具' },
        { href: '/zh/blog/', title: '房間規劃文章' },
        { href: '/zh/feng-shui-bedroom-checker/', title: '臥室風水檢查工具' },
        { href: '/zh/small-bedroom-layout/', title: '小房間配置工具' },
        { href: '/zh/desk-placement-feng-shui/', title: '書桌擺放參考' },
        { href: '/zh/furniture-fit-checker/', title: '家具尺寸檢查' },
      ]} />
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.35rem, 5vw, 4.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-lift);
  }

  .home-hero-copy { position: relative; z-index: 1; }
  .home-hero h1 { max-width: 10ch; }
  .home-hero .lead { max-width: 58ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .hero-note { margin: var(--space-4) 0 0; color: var(--color-muted); font-size: var(--text-sm); }
  .hero-note span { color: var(--color-sage); font-size: 0.65rem; vertical-align: 0.1em; }

  .hero-plan {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 290px;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    overflow: hidden;
  }
  .hero-plan::before, .hero-plan::after { position: absolute; color: rgba(111, 83, 27, 0.22); font-size: 0.68rem; letter-spacing: 0.12em; }
  .hero-plan::before { content: 'N  01'; top: 0.8rem; right: 1rem; }
  .hero-plan::after { content: 'MEASURE · PLACE · LIVE'; right: 1rem; bottom: 0.8rem; }
  .hero-plan-label { position: absolute; top: 0.8rem; left: 1rem; color: var(--color-primary-strong); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.12em; }
  .hero-plan svg { width: min(100%, 420px); margin-inline: auto; }
  .hero-plan .plan-room { fill: var(--color-surface-strong); stroke: var(--color-primary-strong); stroke-width: 2; }
  .hero-plan .plan-door, .hero-plan .plan-route { fill: none; stroke: var(--color-accent); stroke-width: 2; }
  .hero-plan .plan-route { stroke: var(--color-sage); stroke-dasharray: 5 6; }
  .hero-plan .plan-bed { fill: #e4dac4; stroke: var(--color-primary-strong); stroke-width: 1.5; }
  .hero-plan .plan-pillow { fill: #faf7ef; stroke: #c8bda8; }
  .hero-plan .plan-desk { fill: #d9e5df; stroke: var(--color-sage); stroke-width: 1.5; }
  .hero-plan .plan-wardrobe { fill: #ead9cc; stroke: var(--color-accent); stroke-width: 1.5; }
  .hero-plan text { fill: var(--color-muted); font-size: 9px; font-weight: 800; letter-spacing: 0.08em; text-anchor: middle; }
  .hero-plan-caption { display: block; max-width: 27rem; margin: -0.5rem auto 0; color: var(--color-muted); font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.25; text-align: center; }

  .how-it-works { display: grid; gap: 0; padding: 0; margin: 0; border-top: 1px solid var(--color-border); list-style: none; }
  .how-it-works li { display: grid; grid-template-columns: auto 1fr; column-gap: 0.75rem; padding: 0.85rem 0; border-bottom: 1px solid var(--color-border); }
  .how-it-works li > span { grid-row: span 2; color: var(--color-primary); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.08em; }
  .how-it-works strong { font-size: var(--text-sm); }
  .how-it-works small { color: var(--color-muted); font-size: var(--text-sm); }

  .home-section { padding-block: var(--space-5); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-5); }
  .section-heading h2 { margin: 0; }
  .section-count { margin-bottom: 0.25rem; color: var(--color-muted); white-space: nowrap; }
  .tool-primary { margin-bottom: var(--space-4); }
  .tool-card-main { display: grid; gap: var(--space-3); padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--color-primary); border-left: 6px solid var(--color-primary); background: var(--color-primary-soft); }
  .tool-card-main h3 { font-family: var(--font-display); font-size: clamp(1.4rem, 1.15rem + 0.7vw, 2rem); }
  .tool-card-main .button { justify-self: start; }
  .scenario-grid, .post-list { display: grid; gap: 0; border-top: 1px solid var(--color-border); }
  .tool-card, .post-list article { min-height: 100%; padding: var(--space-4) 0; border-bottom: 1px solid var(--color-border); }
  .tool-card { display: grid; gap: 0.35rem; }
  .tool-card h3 { margin-bottom: 0; }
  .tool-card h3 a, .post-list h3 a { color: var(--color-text); text-decoration: none; }
  .tool-card h3 a:hover, .post-list h3 a:hover { color: var(--color-primary-strong); text-decoration: underline; text-decoration-thickness: 2px; }
  .tool-card p, .post-list p:last-child { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .tool-card-index { margin-bottom: 0.35rem; }
  .split-section { display: grid; gap: var(--space-5); }
  .split-section ul { padding-left: 1.2rem; margin-bottom: 0; }
  .split-section li + li { margin-top: 0.35rem; }
  .editorial-section h2 { margin-top: 0; }
  .meta { color: var(--color-muted); font-size: var(--text-sm); }

  @media (min-width: 760px) {
    .home-hero { grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr); align-items: center; }
    .home-hero .how-it-works { grid-column: 1 / -1; grid-template-columns: repeat(3, 1fr); }
    .how-it-works li { padding: 0.9rem 1rem; border-right: 1px solid var(--color-border); border-bottom: 0; }
    .how-it-works li:first-child { padding-left: 0; }
    .how-it-works li:last-child { border-right: 0; }
    .scenario-grid, .post-list, .split-section { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-5); }
    .tool-card:nth-child(odd), .post-list article:nth-child(odd) { padding-right: var(--space-5); }
    .tool-card:nth-child(even), .post-list article:nth-child(even) { padding-left: var(--space-5); border-left: 1px solid var(--color-border); }
  }
</style>
