---
import Layout from '../components/Layout.astro';
import Faq from '../components/Faq.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import PlannerCta from '../components/PlannerCta.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { AFFILIATE_POLICY_LINE } from '../config/affiliate';
import { reviewReadyCategorySlugs } from '../data/contentQuality.mjs';
import { hubContent } from '../data/hubs';
import { categoryMeta, siteUrl } from '../data/site';

// 首頁刻意不再列「最新文章」。自動抓最新更新只會把首頁的內部連結權重
// 灑到隨機的長尾頁面上，也讓首頁看起來像文章牆。改成連到 9 個主題 Hub
// 與人工挑選的核心指南，讓 Google 從首頁就讀到「這個站分成哪些主題」。
const hubs = Object.entries(categoryMeta)
  .filter(([slug]) => reviewReadyCategorySlugs.has(slug) && hubContent[slug])
  .map(([slug, meta]) => ({ href: `/zh/category/${slug}/`, title: meta.title, description: meta.description }));
const keyGuides = [
  { href: '/zh/blog/room-circulation-width-guide/', title: '房間走道要留多寬', text: '整站被引用最多的一篇：用門片、抽屜與椅子的實際尺寸反推走道，而不是背一個數字。' },
  { href: '/zh/blog/bed-size-room-guide/', title: '床尺寸怎麼選', text: '先量走道再挑床。附台灣床墊尺寸對照與床架外框加值表。' },
  { href: '/zh/blog/bed-facing-door-feng-shui/', title: '床對門怎麼處理', text: '床頭對門與床尾對門要分開判斷，先看開門視線與實牆位置。' },
  { href: '/zh/blog/beam-over-desk-bed-layout/', title: '橫樑壓床完整指南', text: '床型、床邊家具、靠窗與租屋不能移床，全部收在同一頁。' },
  { href: '/zh/blog/tiny-room-layout-under-5-ping/', title: '5 坪以下房間怎麼設計', text: '先算扣掉樑柱與門片的淨尺寸，再分配床、桌與收納。' },
  { href: '/zh/blog/small-room-storage-zones/', title: '小房間收納分區', text: '先盤點 30 件常用物品，再規劃五個存放區，不要先買收納盒。' },
];
const title = 'RoomFeng｜免費房間規劃與風水佈局工具';
const description = '輸入房間尺寸、門窗位置與家具需求，快速取得臥室、小房間、小套房與書桌配置建議，並參考床位、鏡子、採光、收納與動線風水提醒。';
const canonical = '/';
const alternates = { zh: '/', en: '/en/' };
const faq = [
  { q: '房間規劃工具可以做什麼？', a: '可以協助你整理房間尺寸、門窗位置、家具需求、動線、採光、收納與風水參考，適合搬家、租屋與買家具前使用。' },
  { q: '風水建議是保證有效嗎？', a: '不是。本站風水內容只作為傳統文化與室內配置參考，不保證任何財運、感情、健康或人生結果。' },
  { q: '小房間也能使用嗎？', a: '可以。小房間與小套房更需要先確認床、桌、衣櫃與主要走道，避免家具放得下卻不好用。' },
  { q: '租屋不能裝潢也可以改善嗎？', a: '可以。可先用家具位置、布簾、床頭板、矮櫃、收納盒與燈光做可復原調整。' },
  { q: '需要註冊才能使用嗎？', a: '不需要。本站以靜態網站與瀏覽器端工具為主，不需要資料庫或帳號。' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RoomFeng',
    url: `${siteUrl}/`,
    inLanguage: 'zh-TW',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'RoomFeng',
    url: siteUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}/` },
    ],
  },
];
const tools = [
  { href: '/zh/room-layout-planner/', title: '房間規劃工具', text: '輸入房間尺寸、門窗與家具需求，取得配置、動線、採光與收納提醒。' },
  { href: '/zh/small-room-storage-planner/', title: '小房間收納規劃器', text: '輸入坪數或房間長寬、床型與衣櫃條件，估算剩餘空間並取得收納方案。' },
  { href: '/zh/room-furniture-size-advisor/', title: '房間傢俱尺寸建議器', text: '依房間長寬建議床、書桌與衣櫃尺寸，並用 60 公分原則試算走道。' },
  { href: '/zh/bed-desk-wardrobe-layout/', title: '臥室配置工具', text: '檢查床、門、窗、衣櫃與書桌的配置順序與睡眠舒適度。' },
  { href: '/zh/small-bedroom-layout/', title: '小房間配置工具', text: '針對小房間、小套房與租屋情境整理收納和多功能家具建議。' },
  { href: '/zh/feng-shui-bedroom-checker/', title: '臥室風水檢查工具', text: '用 checklist 參考床對門、鏡子對床、床頭靠窗與動線問題。' },
  { href: '/zh/bed-door-fix-selector/', title: '床對門化解方案選擇器', text: '輸入床位、房間尺寸與可移動程度，依可行性排序化解做法並附最小尺寸。' },
  { href: '/zh/room-size-layout-templates/', title: '坪數房間配置範本庫', text: '選坪數與需求組合，取得 2-3 個可行配置、走道寬度與常見錯誤提醒。' },
  { href: '/zh/desk-placement-feng-shui/', title: '書桌擺放參考', text: '檢查自然光、插座、椅子後方空間與書桌風水參考。' },
];
const audiences = ['租屋族', '學生', '小房間使用者', '搬家前規劃', '想改善床位與收納的人', '想參考房間風水的人'];
const problems = ['床不知道怎麼擺', '小房間太擠', '書桌採光不好', '衣櫃擋住動線', '鏡子對床', '床對門', '房間收納混亂'];
---

<Layout title={title} description={description} canonical={canonical} lang="zh" alternates={alternates} jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <header class="card">
        <h1>免費房間家具配置規劃工具</h1>
        <p class="lead">輸入房間尺寸、拖曳家具放入平面圖、確認動線與門口，再匯出 PNG 或 PDF。適合租屋族、搬家族、買家具前想確認尺寸的一般人。</p>
        <ol class="how-it-works">
          <li><strong>① 設定房間</strong> — 輸入長、寬、選單位</li>
          <li><strong>② 拖曳家具</strong> — 放床、桌、衣櫃、門窗等，可旋轉、調整尺寸</li>
          <li><strong>③ 匯出 / 取得建議</strong> — 存 PNG/PDF，或參考風水格局與規劃建議</li>
        </ol>
        <div class="cta-row">
          <a class="button" href="/zh/room-layout-planner/">開始畫房間平面圖</a>
          <a class="button secondary" href="/zh/feng-shui-bedroom-checker/">檢查風水格局參考</a>
        </div>
      </header>

      <NewsletterSignup placement="home" />

      <section class="card" aria-labelledby="tools-heading">
        <h2 id="tools-heading">工具入口</h2>
        <div class="tool-primary">
          <article class="tool-card-main">
            <h3><a href="/zh/room-layout-planner/">🗂 拖拉式房間平面圖工具</a></h3>
            <p>輸入房間尺寸，拖曳家具（床、書桌、衣櫃、沙發、門、窗、鏡子），檢查動線、門口、走道寬度，匯出 PNG 或 PDF。<strong>這是主要工具。</strong></p>
            <a class="button" href="/zh/room-layout-planner/">立即使用</a>
          </article>
        </div>
        <div class="scenario-grid" style="margin-top:var(--space-4)">
          {tools.map((tool) => (
            <article>
              <h3><a href={tool.href}>{tool.title}</a></h3>
              <p>{tool.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card split-section" aria-labelledby="audience-heading">
        <div>
          <h2 id="audience-heading">適合誰使用</h2>
          <ul>{audiences.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h2>可以解決哪些問題</h2>
          <ul>{problems.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <section class="card" aria-labelledby="how-heading">
        <h2 id="how-heading">Room Planner 怎麼用</h2>
        <ol class="how-steps">
          <li><strong>量三件事</strong>：房間內徑長寬、門片開啟方向與寬度、窗戶位置。有橫樑時再加樑的兩條投影線。</li>
          <li><strong>拖進家具</strong>：床、書桌、衣櫃、沙發、門、窗、鏡子都可以旋轉與改尺寸，數字直接以公分輸入。</li>
          <li><strong>看警示</strong>：工具會標出家具超出房間、門口被擋住、主要走道低於 60 公分，中文版另有床對門、鏡子對床、床頭無支撐等民俗參考提醒。</li>
          <li><strong>匯出</strong>：存成 PNG 或 PDF，買家具、搬家或跟房東溝通時直接拿出來對。</li>
        </ol>
        <p class="muted">全部在瀏覽器裡運算，不需要註冊、沒有資料庫，草稿存在你自己的瀏覽器裡。</p>
      </section>

      <PlannerCta
        preset="double"
        heading="直接載入一個範例房間試試"
        text="不想從空白開始的話，可以先載入雙人房範例，把尺寸改成你家的數字，再拖動床與衣櫃看警示怎麼變。"
      />

      <section class="card" aria-labelledby="hub-heading">
        <h2 id="hub-heading">主題入口</h2>
        <p>RoomFeng 的內容分成這幾個主題，每一個都有導讀、核心問題、精選指南與對應工具。</p>
        <div class="scenario-grid">
          {hubs.map((hub) => (
            <article>
              <h3><a href={hub.href}>{hub.title}</a></h3>
              <p>{hub.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card" aria-labelledby="guides-heading">
        <h2 id="guides-heading">最值得先讀的指南</h2>
        <p>這幾篇是人工挑選的核心指南，不是依更新時間自動排出來的清單。</p>
        <div class="post-list">
          {keyGuides.map((guide) => (
            <article>
              <h3><a href={guide.href}>{guide.title}</a></h3>
              <p>{guide.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="card" aria-labelledby="editorial-heading">
        <h2 id="editorial-heading">RoomFeng 如何整理公開指南</h2>
        <p>本站不以大量短文覆蓋相似搜尋詞。未達公開標準的內容不會列入文章清單與搜尋索引；只有完成實際尺寸檢查流程、可執行案例、限制說明、站內工具驗證與人工編輯的指南才會公開。</p>
        <ul>
          <li>先量房間、門窗、插座與家具外徑，再寫配置結論。</li>
          <li>數字只作規劃起點，不能取代建築、消防、無障礙或專業設計規範。</li>
          <li>風水只分開標示為民俗文化參考，不包裝成健康或人生結果。</li>
          <li>{AFFILIATE_POLICY_LINE}</li>
          <li>相似搜尋詞不另開新頁，一律併進同一篇完整指南的不同段落；合併掉的舊網址以 301 轉到最相關的指南。</li>
        </ul>
        <p>內容方法、作者說明與更正方式可查看 <a href="/about/#editorial-process">編輯與審查流程</a>。</p>
      </section>
      <Faq items={faq} />
      <RelatedLinks links={[
        { href: '/zh/room-layout-planner/', title: '拖拉式房間平面圖工具' },
        { href: '/zh/blog/', title: '房間規劃文章' },
        { href: '/zh/feng-shui-bedroom-checker/', title: '臥室風水檢查工具' },
        { href: '/zh/small-bedroom-layout/', title: '小房間配置工具' },
        { href: '/zh/desk-placement-feng-shui/', title: '書桌擺放參考' },
        { href: '/zh/furniture-fit-checker/', title: '家具尺寸檢查' },
      ]} />
    </div>
  </section>
</Layout>

<style>
  .how-steps {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    padding-left: 1.2rem;
  }

  .muted {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .how-it-works {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-3) 0 var(--space-4);
    background: var(--color-surface-muted, #f7f6f3);
    border-radius: var(--radius-md);
    list-style: none;
    font-size: var(--text-sm);
  }

  .tool-primary {
    margin-bottom: var(--space-4);
  }

  .tool-card-main {
    border: 2px solid var(--color-primary, #2f6f62);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .cta-row,
  .post-list,
  .scenario-grid {
    display: grid;
    gap: var(--space-4);
  }

  .scenario-grid article,
  .post-list article {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .split-section {
    display: grid;
    gap: var(--space-5);
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 760px) {
    .cta-row {
      grid-template-columns: repeat(2, max-content);
    }

    .scenario-grid,
    .post-list,
    .split-section {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
