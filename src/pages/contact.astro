---
import Layout from '../components/Layout.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';

const title = '聯絡我們｜RoomFeng';
const description = '回報錯誤、提出房間格局規劃需求、隱私問題、授權問題或網站內容建議。';
const faq = [
  { q: '可以請你們幫我看房間風水嗎？', a: '本站不提供個人命理、占卜或結果保證服務。工具與文章只會提供民俗文化與空間舒適度角度的參考提醒。' },
  { q: '回報問題時應提供哪些資訊？', a: '請提供頁面網址、裝置與瀏覽器、你看到的問題、是否能重現，以及不含敏感個資的簡短描述。' },
  { q: '現在有聯絡表單嗎？', a: '沒有。本站維持靜態架構，請使用公開聯絡信箱 btcson224@gmail.com 回報問題或提出建議。' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  url: 'https://roomfeng.win/contact/',
};
---

<Layout title={title} description={description} canonical="/contact/" lang="zh" alternates={{ zh: '/contact/', en: '/en/contact/' }} jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <article class="card">
        <h1>聯絡我們</h1>
        <p class="lead">如果你發現頁面錯誤、內容不清楚、授權資訊需要補充，或希望提出房間格局規劃工具的實用需求，可以寄信到 <a href="mailto:btcson224@gmail.com">btcson224@gmail.com</a>。</p>
        <p>我們重視具體、可核對的回饋，例如按鈕文字不清楚、手機上閱讀不順、某個尺寸計算有誤，或常見的家具配置情境尚未涵蓋。請附上相關頁面網址，讓我們能找到你指出的位置。</p>
        <p>回報技術問題時，請盡量提供頁面網址、使用的瀏覽器與裝置、操作步驟、預期結果與實際結果。若問題和房間資料有關，請只提供必要的示例尺寸，不要傳送完整住址、門牌、租約、身份資料、付款資訊或其他敏感內容。規劃工具預設會把草稿存在瀏覽器 localStorage，不會上傳到伺服器；因此我們通常也無法從伺服器端替使用者找回本機草稿。</p>
        <p>若你要詢問風水內容，請注意本網站只會以民俗文化與空間舒適度參考的方式處理。可以回報某段文字是否過度肯定、是否缺少免責連結、是否容易讓人誤解為結果保證；但本站不提供個人命盤、占卜、住宅吉凶判定或任何關於財富、健康、人際、感情、運氣的承諾。</p>
        <p>隱私、電子報或匯出信件問題，請註明使用的功能與相關 Email；商業合作或一般建議也可寄到同一信箱。我們會依訊息內容檢視，但無法承諾固定回覆時間。請勿寄送密碼、付款資料或完整住址。</p>
      </article>
      <div class="cta-band">
        <p>回報前可先查看免責聲明，確認風水參考的語氣與限制。</p>
        <a class="button" href="/disclaimer/">查看免責聲明</a>
      </div>
      <Faq lang="zh" items={faq} />
      <RelatedLinks lang="zh" links={[{ href: '/about/', title: '關於本站' }, { href: '/privacy/', title: '隱私權政策' }, { href: '/changelog/', title: '更新紀錄' }]} />
    </div>
  </section>
</Layout>
