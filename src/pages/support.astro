---
import Layout from '../components/Layout.astro';
import AffiliateRecs from '../components/AffiliateRecs.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { affiliateProducts } from '../data/affiliateProducts';
import { siteUrl } from '../data/site';

const canonical = '/support/';
const activeAffiliateCount = affiliateProducts.length;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: '支持 RoomFeng｜蝦皮與酷澎實用商品參考', description: '用免費房間配置工具先規劃，再從與 FunnyTools 共用的蝦皮與酷澎商品庫自行比較。', url: `${siteUrl}${canonical}`, inLanguage: 'zh-TW' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '支持我們', item: `${siteUrl}${canonical}` },
  ] },
];
const faq = [
  { q: 'RoomFeng 會因為我點擊連結而收費嗎？', a: '不會。RoomFeng 的工具與內容免費使用；如果你從本頁的蝦皮或酷澎聯盟連結購買，本站可能收到分潤，但不會因此增加你的購買價格。' },
  { q: '商品資料是不是 RoomFeng 保證的規格？', a: '不是。商品名稱、規格、庫存、配送和其他條件可能變動，請以蝦皮或酷澎當下商品頁與賣家說明為準，並自行評估需求。' },
  { q: '為什麼推薦頁面沒有價格或銷量？', a: '價格、銷量與分潤等資訊會變動，也不是房間配置判斷的必要條件；本站只保留商品庫提供的中性描述，避免把快照數據當成保證。' },
  { q: '風水內容和商品推薦有關嗎？', a: `風水內容僅作民俗文化與空間舒適度參考，不保證財運、健康、感情、事業或任何結果。商品庫與 FunnyTools 共用，涵蓋 ${activeAffiliateCount} 筆蝦皮與酷澎日常商品；推薦不能取代安全、尺寸、採光、通風與動線判斷。` },
];
---

<Layout title="支持 RoomFeng｜蝦皮與酷澎實用商品參考" description="先用免費房間配置工具規劃，再從與 FunnyTools 共用的蝦皮與酷澎商品庫自行比較。" canonical={canonical} lang="zh" jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <header class="card support-hero">
        <p class="meta">RoomFeng 支持頁</p>
        <h1>支持 RoomFeng，也先把房間規劃好</h1>
        <p class="lead">RoomFeng 的免費工具與文章優先，這裡只是提供與房間配置情境相關的居家用品參考。</p>
        <p>你可以先用<a href="/zh/room-layout-planner/">房間家具配置工具</a>量好房間、家具外框和走道，再決定是否需要目錄中的商品。本頁的連結來自蝦皮與酷澎聯盟行銷；若你透過連結購買，本站可能獲得分潤，不影響你的購買價格。商品資料可能更新，請以對應商品頁為準。</p>
        <p>本頁與 FunnyTools 共用同一份商品庫，整個庫涵蓋蝦皮與酷澎的 {activeAffiliateCount} 筆 active 商品，包含 3C、辦公、居家、收納、清潔、旅行與日常用品；為避免一次塞太多，頁面每次只顯示其中一小批，你可以按「換一批商品」逐批瀏覽完整商品庫。部分商品屬客製或規格型，價格會依選項變動。圖片為本站保存的公開商品圖，實際款式與顏色仍以商品頁為準。推薦不代表適合每個房間，也不保證任何風水或生活效果。</p>
      </header>

      <AffiliateRecs productIds={affiliateProducts.map((product) => product.id)} heading="實用居家用品參考" intro="每次顯示部分品項，可按「換一批商品」瀏覽整個商品庫；請先核對尺寸、材質、安全與賣場最新資訊。" />

      <section class="card">
        <h2>如何使用這份目錄</h2>
        <ol>
          <li>先量房間長寬、門窗、家具外徑，以及家具門片或抽屜打開後需要的距離。</li>
          <li>用工具畫出配置，確認主要走道、坐下與取物位置，再挑選實際有幫助的品項。</li>
          <li>開啟蝦皮商品頁重新確認尺寸、材質、庫存、配送、退換貨與賣家說明。</li>
        </ol>
        <p>RoomFeng 不代替商品頁、專業丈量或安全判斷；租屋、共享空間和有兒童或長者的家庭，尤其要把固定、防滑、承重和通行優先放在任何風格或民俗考量之前。</p>
      </section>

      <Faq items={faq} />
      <RelatedLinks links={[{ href: '/zh/room-layout-planner/', title: '房間家具配置工具' }, { href: '/zh/furniture-fit-checker/', title: '家具尺寸檢查' }, { href: '/disclaimer/', title: '風水與內容免責聲明' }]} />
    </div>
  </section>
</Layout>
