---
import Layout from '../../components/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import MovingOsContextCta from '../../components/MovingOsContextCta.astro';
import { en } from '../../i18n/en';
import MeasuredPlan from '../../components/MeasuredPlan.astro';
import PlannerHandoffLink from '../../components/PlannerHandoffLink.astro';
import '../../styles/uiux-prototypes.css';

const title = 'Studio Apartment Layout Planner | Plan Sleep Work and Dining Zones';
const description = 'Plan a studio apartment layout with practical zoning tips for sleeping, working, eating, storage, walkways, and furniture fit in one open room.';
const canonical = '/en/studio-apartment-layout/';
const alternates = { zh: '/zh/studio-apartment-layout/', en: '/en/studio-apartment-layout/' };
const siteUrl = 'https://roomfeng.win';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Studio Apartment Layout Planner',
    description,
    inLanguage: 'en',
    author: { '@type': 'Organization', name: 'RoomFeng' },
    mainEntityOfPage: `${siteUrl}${canonical}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Studio apartment layout', item: `${siteUrl}${canonical}` },
    ],
  },
];
const faq = [
  { q: 'How do I divide a studio apartment without building walls?', a: 'Use furniture orientation, rugs, shelves, lighting, and clear walkways to suggest zones while keeping the room easy to move through.' },
  { q: 'Should the bed or sofa be placed first?', a: 'Place the largest and least flexible item first. In many studios that is the bed, but a sofa bed or work-from-home desk may change the priority.' },
  { q: 'Can a dining table fit in a studio?', a: 'A small round table, wall table, drop-leaf table, or desk-dining combination can work if chair pull-out space is included in the plan.' },
  { q: 'What is the biggest studio layout problem?', a: 'Overlapping zones. The bed, desk chair, dining chair, and entry route often compete for the same floor space.' },
];
const relatedLinks = [
  { href: '/en/room-layout-planner/', title: 'Room layout planner' },
  { href: '/en/apartment-furniture-planner/', title: 'Apartment furniture planner' },
  { href: '/en/small-bedroom-layout-planner/', title: 'Small bedroom layout planner' },
  { href: '/en/furniture-fit-checker/', title: 'Furniture fit checker' },
  { href: '/en/layout-guides/300-sq-ft-studio-layout/', title: '300 sq ft studio layout guide' },
  { href: '/en/350-sq-ft-studio-apartment-layout/', title: '350 sq ft studio layout guide' },
  { href: '/en/400-sq-ft-studio-apartment-layout/', title: '400 sq ft studio layout guide' },
  { href: '/en/450-sq-ft-studio-apartment-layout/', title: '450 sq ft studio layout guide' },
  { href: '/en/500-sq-ft-studio-apartment-layout/', title: '500 sq ft studio layout guide' },
];
const studioItems = [
  { id: 'studio-bed', type: 'bed' as const, label: 'Bed', widthCm: 150, depthCm: 190, xCm: 30, yCm: 40, rotationDeg: 0 },
  { id: 'studio-desk', type: 'desk' as const, label: 'Work desk', widthCm: 100, depthCm: 50, xCm: 250, yCm: 50, rotationDeg: 0 },
  { id: 'studio-storage', type: 'wardrobe' as const, label: 'Storage', widthCm: 120, depthCm: 45, xCm: 400, yCm: 350, rotationDeg: 0 },
];
---

<Layout title={title} description={description} canonical={canonical} lang="en" alternates={alternates} jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <header class="landing-intro card">
        <p class="eyebrow">STUDIO SIZE · MEASURED START</p>
        <h1>Studio apartment layout planner</h1>
        <p class="lead">Start with a 560 × 500 cm open area, then place the 150 × 190 cm bed, work desk, and storage footprint before replacing the prototype with your measured room.</p>
      </header>
      <section class="measured-landing" aria-labelledby="studio-prototype-heading">
        <header class="measured-landing-header"><div><h2 id="studio-prototype-heading">A studio starts with zones, then furniture</h2></div><p>Keep one clear route from entry to the daily anchors. The SVG uses the same centimetre coordinate system for the room, zones, and footprints; kitchen, bathroom, columns, and fixed services still need their own measurements.</p></header>
        <div class="measured-layout-grid">
          <div class="measured-plan" aria-label="560 by 500 centimetre studio measured zoning diagram">
            <MeasuredPlan roomWidthCm={560} roomLengthCm={500} ariaLabel="560 by 500 centimetre studio with 150 by 190 bed, 100 by 50 desk, and 120 by 45 storage" zones={[{ x: 0, y: 0, width: 220, depth: 250, label: 'SLEEP ZONE' }, { x: 220, y: 0, width: 180, depth: 180, label: 'WORK ZONE' }, { x: 390, y: 280, width: 170, depth: 220, label: 'STORAGE ZONE' }]} furniture={[{ x: 30, y: 40, width: 150, depth: 190, label: 'BED', className: 'bed' }, { x: 250, y: 50, width: 100, depth: 50, label: 'DESK', className: 'desk' }, { x: 400, y: 350, width: 120, depth: 45, label: 'STORAGE', className: 'storage' }]} route="M 20 460 L 190 300 L 230 260 L 230 230" />
          </div>
          <div class="measured-facts"><dl><dt>Open-area start</dt><dd>560 × 500 cm</dd><dt>Sleep anchor</dt><dd>150 × 190 cm bed</dd><dt>Work zone</dt><dd>100 × 50 cm desk</dd><dt>Storage zone</dt><dd>120 × 45 cm cabinet</dd><dt>Main route</dt><dd>Entry → bed → storage</dd></dl><div class="measured-check"><strong>Check this first</strong><span>A tall cabinet or divider changes light and ventilation. This studio prototype is a zoning start, not the full usable area of an apartment.</span></div><PlannerHandoffLink href="/en/room-layout-planner/?rf_quick_handoff=1" label="Try this size in Planner" roomWidthCm={560} roomLengthCm={500} source="studio-apartment-layout" items={studioItems} /></div>
        </div>
        <div class="measured-flow"><div><span>01 · ZONE</span><strong>Keep the entry route continuous</strong></div><div><span>02 · PLACE</span><strong>Place bed, desk, and storage</strong></div><div><span>03 · CHECK</span><strong>Check light and turning space</strong></div></div>
      </section>
      <article class="card seo-article">
        <p class="lead">A studio apartment has to support sleeping, working, eating, relaxing, storage, and entry circulation in one room. The goal is not to fill every wall, but to make each zone usable.</p>
        <p>
          Studio planning is different from bedroom planning because every piece affects multiple routines. A bed beside the entry may save wall space but make the home feel less private. A sofa floating in the middle can create a living zone but may narrow the route to the kitchen. A desk by the window may be pleasant for work but can block a curtain, heater, or balcony door. A floor plan helps you test these relationships before choosing furniture that locks you into one awkward setup.
        </p>
        <p>
          Start by identifying the fixed points: entrance, kitchen edge, bathroom door, windows, outlets, radiators, closets, and balcony doors. Then decide which zone matters most for your daily life. If you work from home, the desk deserves clear chair space and light control. If you often host one or two people, a sofa or small dining table may matter more. If the studio is mainly for sleep and storage, prioritize a calm bed area and easy access to clothes.
        </p>
        <p>
          If you only have a listing area, use the <a href="/en/room-size-layout-templates/">room sizer templates</a> to understand how shape changes the result, but replace that assumption with the clear open-room dimensions before buying. For a whole apartment with separate rooms, use the <a href="/en/apartment-furniture-planner/">apartment furniture planner</a>; this studio guide is specifically for overlapping zones in one open room.
        </p>

        <h2>Zoning and clearance tips</h2>
        <p>
          Use furniture backs and edges to create zones. A wardrobe can separate sleep and entry, an open shelf can divide bed and living areas without fully blocking light, and a rug can define a sofa area. Keep a main walkway from the door to the kitchen and bathroom clear. Avoid layouts where the desk chair, dining chair, and bed access all need the same narrow strip of floor.
        </p>
        <p>
          Compact furniture matters, but multifunctional furniture only helps if it remains easy to use. A sofa bed is useful when it can open without moving half the room. A drop-leaf table is useful when folded and unfolded positions both fit. Under-bed storage helps only if there is space to pull bins out. Plan the open state, not just the closed state.
        </p>

        <h2>How to do this with the planner</h2>
        <ol>
          <li>Open the <a href="/en/room-layout-planner/">room layout planner</a> and enter the full studio room dimensions.</li>
          <li>Add the entrance door, bathroom or closet door positions, and windows as reference items.</li>
          <li>Place the bed, then test whether the sofa, desk, or dining area works better near the window or near the kitchen side.</li>
          <li>Add storage and check whether doors, drawers, and chair pull-back space overlap with the main route.</li>
          <li>Export two versions: one optimized for work and one optimized for relaxing, then compare the tradeoffs.</li>
        </ol>
        <p>
          The best studio layout usually has fewer, better-positioned pieces. If a zone only works when furniture is constantly moved, consider a smaller item or a combined use such as a desk that also works as a dining surface.
        </p>
      </article>

      <div class="cta-band">
        <div>
          <h2>Map your studio zones before buying furniture</h2>
          <p>Try sleep, work, dining, and storage layouts in one to-scale plan.</p>
        </div>
        <a class="button" href="/en/room-layout-planner/">{en.cta.openPlanner}</a>
      </div>
      <MovingOsContextCta locale="en" placement="en_studio_apartment" heading="Turning a studio plan into a move plan?" copy="Carry the measured zones into a practical move workflow with furniture decisions, box tracking, budget, and move-day tasks—not just a final floor plan." label="Plan move-in" />
      <AdSlot id="en-studio-mid" placement="en-studio-mid" />
      <Faq lang="en" items={faq} />
      <RelatedLinks lang="en" links={relatedLinks} />
    </div>
  </section>
</Layout>
