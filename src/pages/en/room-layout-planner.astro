---
import Layout from '../../components/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import MovingOsContextCta from '../../components/MovingOsContextCta.astro';
import '../../styles/planner.css';

const title = 'Room Layout Planner | Free Online Furniture Planner';
const description = 'Drag furniture onto a to-scale floor plan, enter actual room and furniture dimensions, check fit and walkways, and export your layout free with no sign-up.';
const canonical = '/en/room-layout-planner/';
const alternates = { zh: '/zh/room-layout-planner/', en: '/en/room-layout-planner/' };
const siteUrl = 'https://roomfeng.win';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'RoomFeng Room Planner',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Web browser',
    url: `${siteUrl}${canonical}`,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Room Planner', item: `${siteUrl}${canonical}` },
    ],
  },
];
const faqItems = [
  {
    q: 'Does the planner upload my room layout?',
    a: 'No. Drafts are stored in your browser localStorage by default, and PNG or PDF exports are generated in the browser.',
  },
  {
    q: 'Can I use it before buying furniture?',
    a: 'Yes. Enter the room size, add the furniture you are considering, and check whether the door swing, walkway, and large items still fit.',
  },
  {
    q: 'Does the English planner include feng shui checks?',
    a: 'No. The English tool shows structural checks only: room bounds, blocked door clearance, and narrow walkway warnings.',
  },
];
const relatedLinks = [
  { href: '/en/room-size-layout-templates/', title: 'Room sizer and calculated templates' },
  // 2026-09-05: this page had no inbound link from anywhere in the build, so it
  // was an orphan in the sitemap. The planner is its natural parent.
  { href: '/en/beam-layout-fix-check/', title: 'Ceiling beam clearance check' },
  { href: '/en/apartment-furniture-planner/', title: 'Apartment furniture planning workflow' },
  { href: '/en/furniture-fit-calculator/', title: 'Furniture fit calculator' },
  { href: '/en/bed-room-fit-calculator/', title: 'Bed room fit calculator' },
  { href: '/en/couch-fit-through-door-calculator/', title: 'Couch fit through door calculator' },
  { href: '/zh/room-layout-planner/', title: '中文房間家具配置工具' },
  { href: '/en/privacy/', title: 'Privacy policy' },
  { href: '/en/disclaimer/', title: 'Disclaimer' },
];
---

<Layout title={title} description={description} canonical={canonical} lang="en" pageType="planner" adsenseDeferred={true} alternates={alternates} jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <header>
        <h1>RoomFeng Room Planner</h1>
        <p class="lead">
          Use this free online room layout planner to enter actual room and furniture dimensions, then drag each item around a to-scale floor plan. Check furniture fit, door clearance, and walkway width, then save or export your layout with no sign-up.
        </p>
      </header>

      <div id="room-planner" data-planner></div>

      <div class="planner-ad-slot"><AdSlot id="planner-mid-en" placement="room-layout-planner-en-mid" /></div>

      <section class="cta-band">
        <div>
          <h2>Check the layout before moving furniture</h2>
          <p>Use the <a href="/en/room-size-layout-templates/">room sizer templates</a> when you need a preset starting shape, then return here to drag measured furniture and openings. Planning several rooms and purchase priorities instead? Follow the <a href="/en/apartment-furniture-planner/">apartment furniture planner workflow</a>.</p>
        </div>
        <a class="button secondary" href="/en/privacy/">How drafts are stored</a>
      </section>

      <MovingOsContextCta locale="en" placement="en_room_planner" heading="Planning the whole move, not just one room?" copy="Moving & New Home OS combines measurements, furniture decisions, packing, budget and move-day planning in one private workspace." label="Plan My Move" />

      <Faq lang="en" items={faqItems} />
      <RelatedLinks lang="en" links={relatedLinks} />
    </div>
  </section>
<script>
  import { initPlanner } from '../../planner/planner';

  const strings = {
    locale: 'en',
    dateLocale: 'en-US',
    roomLength: 'Room length',
    roomWidth: 'Room width',
    unit: 'Unit',
    palette: 'Add furniture',
    templatesLabel: 'Templates',
    selectedItem: 'Selected item',
    noSelection: 'Select an item in the plan to rotate, resize, or delete it.',
    width: 'Width',
    height: 'Depth',
    rotation: 'Angle',
    rotationSliderLabel: 'Angle slider',
    area: 'Room area',
    checksTitle: 'Structural checks',
    noWarnings: 'No obvious layout warnings right now.',
    saveStatus: 'Draft saved',
    confirmClear: 'Clear this design and return to the default layout?',
    itemList: 'Furniture list',
    disclaimerLink: 'Read disclaimer',
    emptyHint: 'Add furniture, or choose a template.',
    units: { cm: 'cm', m: 'm', ft: 'ft' },
    furniture: {
      bed: 'Bed',
      desk: 'Desk',
      wardrobe: 'Wardrobe',
      sofa: 'Sofa',
      diningTable: 'Dining table',
      door: 'Door',
      window: 'Window',
      mirror: 'Mirror',
      custom: 'Custom',
    },
    customItem: {
      label: 'Custom item',
      namePlaceholder: 'Name (e.g. TV cabinet)',
      addButton: 'Add custom item',
      editNameLabel: 'Item name',
    },
    actions: {
      add: 'Add',
      rotate90: 'Rotate 90°',
      delete: 'Delete',
      exportPng: 'Export PNG',
      exportPdf: 'Export PDF',
      save: 'Save',
      clear: 'Clear design',
      saveExport: 'Save and export',
    },
    navigation: {
      room: 'Room', furniture: 'Furniture', templates: 'Templates', checks: 'Checks', report: 'Report',
      toolsLabel: 'Planner tools', setupEyebrow: 'SETUP', closeDrawer: 'Close setup panel', canvasLabel: 'Room floor plan',
      canvasHint: 'Drag furniture · Select to adjust', mobileActionsLabel: 'Mobile planner actions',
    },
    drawer: { roomTitle: 'Room setup', furnitureTitle: 'Add furniture', templatesTitle: 'Layout templates', checksTitle: 'Dimension checks', reportTitle: 'Export report' },
    report: {
      eyebrow: 'EXPORT REPORT · LOCAL PREVIEW', title: 'RoomFeng dimension plan report', status: 'Local draft', room: 'Room', area: 'Area', furniture: 'Furniture', checks: 'Checks',
      checksPass: 'Ready to review', checksNeedsReview: (count: number) => `${count} to review`, moreItems: (count: number) => `${count} more furniture items`,
      note: 'The report keeps room dimensions, furniture footprints, and structural checks. Verify door widths, turns, and actual outside dimensions before buying or moving.',
    },
    accessibility: { selectedSuffix: ', selected' },
    exportReport: {
      title: 'RoomFeng dimension plan report', exportedAt: 'Exported', room: 'Room dimensions', area: 'Area', furniture: 'Furniture footprints (current design)', noFurniture: 'No furniture yet', checks: 'Dimension checks', noChecks: 'No structural warnings right now; verify on site.',
      disclaimer: 'Planning reference only. Verify actual on-site dimensions before purchase, installation, moving, or construction.', pngSubtitle: 'MEASURE · PLAN · CHECK',
    },
    templates: {
      studio: 'Studio',
      student: 'Student room',
      double: 'Double room',
      living: 'Living room',
    },
    warnings: {
      bounds: 'Furniture extends outside the room boundary. Adjust its position or size.',
      door: 'The door swing or entry clearance may be blocked by furniture.',
      aisle: 'The main walkway may be under about 60 cm, which can feel cramped.',
    },
    fengShui: {
      sectionTitle: 'Feng shui reference',
      bedFacingDoor: '',
      mirrorFacingBed: '',
      deskNoSupport: '',
      doorwayBlocked: '',
      headboardNoWall: '',
      noWarnings: '',
    },
  };

  const target = document.querySelector('[data-planner]');
  if (target instanceof HTMLElement) {
    initPlanner(target, { strings, fengShui: false, storageKey: 'room-layout-planner:en' });
  }
</script>

</Layout>
