---
import Layout from '../../../components/Layout.astro';
import MovingOsApp from '../../../components/MovingOsApp.astro';
const title = 'Moving & New Home OS App | RoomFeng';
const description = 'Local-first moving project workspace for measurements, furniture fit, tasks, boxes, budget, shopping comparisons, and exports.';
const canonical = '/en/moving-new-home-os/app/';
const alternates = { en: canonical, zh: '/zh/moving-new-home-os/app/' };
---
<Layout title={title} description={description} canonical={canonical} lang="en" alternates={alternates} noindex pageType="planner">
  <MovingOsApp locale="en" />
</Layout>
