---
import Layout from '../../../components/Layout.astro';
import { approvedLayouts } from '../../../small-space/approved-layouts';
import { renderLayoutSvg } from '../../../small-space/renderer';
import '../../../styles/layout-guide.css';
import type { LayoutRecord } from '../../../small-space/types';

const siteUrl = 'https://roomfeng.win';
const guides: Record<string, { title: string; description: string; heading: string; lead: string; answer: string; geometry: string; strategy: string; tradeoff: string; assumptions: string; ids: string[] }> = {
  '10x10-bedroom-layout': { title: '10×10 Bedroom Layout Ideas With a Queen Bed | RoomFeng', description: 'Compare three dimension-validated 10×10 bedroom starting points for a Queen bed, desk, and usable circulation.', heading: 'A 10 × 10 bedroom needs a deliberate first move', lead: 'A square room does not automatically make every arrangement equal. The first decision is whether the bed, work surface, or open centre gets the clearest zone.', answer: 'For a 10 × 10 ft room (3048 × 3048 mm), a Queen bed and a desk can fit only when the frame and chair movement are treated as real footprints. Start with a validated strategy, then replace every nominal size with your actual products.', geometry: 'The square anchor is 3000 × 3000 mm (about 9 ft 10 in × 9 ft 10 in). The flagship Queen examples use a 3048 × 3658 mm room, so do not copy their clearances into a true 10 × 10 without checking.', strategy: 'Bed-centred, work-first, and open-centre strategies make different promises: access to both bed sides, a usable work wall, or more flexible floor in the middle.', tradeoff: 'The more space given to a desk chair or storage wall, the less generous the opposite bed approach becomes.', assumptions: 'Doors and windows follow each layout record’s template scenario. They are planning assumptions until you add the real openings in Planner.', ids: ['BR-SQ-001', 'BR-SQ-002', 'BR-SQ-003'] },
  '10x12-bedroom-queen-desk': { title: '10×12 Bedroom Layout With Queen Bed and Desk | RoomFeng', description: 'See three real 10×12 bedroom strategies for a Queen bed, desk, wardrobe, and everyday circulation.', heading: 'Three ways to use a 10 × 12 bedroom', lead: 'The extra two feet of length can become a work zone, a storage wall, or a calmer route around the bed. The useful answer depends on what you do every day.', answer: 'A 10 × 12 ft room is about 3048 × 3658 mm. The three approved anchors below share the same envelope but change the strategy, so you can compare work usability against bed access and storage.', geometry: 'The RoomFeng 10 × 12 anchors are 3048 × 3658 mm. A Queen mattress is not the outside footprint of its frame; reserve additional depth for the frame, chair pull-out, and wardrobe doors.', strategy: 'The light-route plan protects an entry path, the wardrobe-wall plan concentrates storage, and the balanced plan includes a Taiwan 5-ft bed with desk and wardrobe.', tradeoff: 'A clearer central route may require one-sided bed access; a larger storage wall narrows the work approach.', assumptions: 'The records assume a rectangular room with the documented door and window scenarios. Confirm your actual wall positions before buying.', ids: ['BR-1012-001', 'BR-1012-002', 'BR-1012-003'] },
  '3x3m-bedroom-layout': { title: '3×3 Metre Bedroom Layout: Bed, Desk and Storage | RoomFeng', description: 'Use three validated 3000 × 3000 mm bedroom layouts to compare sleep, work, and open-centre priorities.', heading: 'A 3 × 3 metre bedroom is a priority exercise', lead: 'At 9 square metres, adding every wish at once makes the route fail quickly. Choose the two things that matter most, then use a strategy that names its compromise.', answer: 'The 3000 × 3000 mm square anchors support a Queen, work-first Queen, or Full with flexible desk. They are not interchangeable: the bed-centred option protects access while the work-first option gives the desk the better wall.', geometry: 'Each layout uses a 3000 × 3000 mm clear rectangle. Check your skirting, radiator, wardrobe door and bed-frame allowance against that clear dimension.', strategy: 'Bed-centred is the calmer couple setup, work-first favours a regular desk routine, and open-centre preserves flexibility for a single sleeper.', tradeoff: 'A Queen in the square envelope leaves less spare circulation than a Full; the flexible plan gives up some storage certainty.', assumptions: 'The layout registry records a rectangle and its own door/window scenario. Treat the plan as a measured starting point, not a building-code drawing.', ids: ['BR-SQ-001', 'BR-SQ-002', 'BR-SQ-003'] },
  '3x3-6m-bedroom-layout': { title: '3×3.6 Metre Bedroom Layout Ideas | RoomFeng', description: 'Compare three validated 2700 × 3600 mm bedroom layouts for a double bed, desk, wardrobe, and a stable route.', heading: 'Use the 3 × 3.6 metre length to separate zones', lead: 'A 2700 × 3600 mm room is long enough to place sleep and work in distinct bands, but only if the entry route is not treated as leftover space.', answer: 'The three medium anchors below compare a double-first bed with stable storage, a desk-first Queen, and a storage-first double with open foot space. Pick by routine rather than by the prettiest rectangle.', geometry: 'The clear anchor is 2700 × 3600 mm. The long edge is 900 mm deeper than the 3 × 3 m square, which is enough to change the end-zone strategy but not enough to ignore chair clearance.', strategy: 'Double-first keeps the wardrobe wall predictable; desk-first protects a work wall; storage-first makes the foot of the bed more open.', tradeoff: 'Zone separation can create a longer route to storage, while a concentrated storage wall makes the entry side tighter.', assumptions: 'Use the documented rectangle and fixture assumptions as a baseline. Add real door swing and window location in the Planner before installation.', ids: ['BR-MN-001', 'BR-MN-002', 'BR-MN-003'] },
  'narrow-bedroom-layout': { title: 'Narrow Bedroom Layout: Twin Bed, Desk and Clear Route | RoomFeng', description: 'Compare three validated 2400 × 3600 mm narrow-bedroom strategies without pretending a square plan will work.', heading: 'A narrow room needs a long-wall decision', lead: 'In a narrow bedroom, turning every item sideways is not a strategy. The three anchors below keep the 2400 mm width visible and make the circulation compromise explicit.', answer: 'The 2400 × 3600 mm narrow-room records place a Twin bed with either a long-wall route, an end-wall work zone, or linear storage and a work nook. They are designed for different daily patterns.', geometry: 'The narrow anchor is 2400 × 3600 mm. A Twin mattress may be about 990 × 1905 mm in these records; bed frames, chair pull-out and door swings consume more than the mattress rectangle.', strategy: 'Long-wall bed protects the primary route, end-wall bed gives work a distinct zone, and linear storage keeps the middle legible.', tradeoff: 'The work-zone version narrows one approach, while the storage version asks you to keep the central route disciplined.', assumptions: 'Fixture positions are the records’ assumptions. A real radiator or inward-swinging door can change a strong match into a review-required condition.', ids: ['BR-N-001', 'BR-N-002', 'BR-N-003'] },
  '300-sq-ft-studio-layout': { title: '300 Sq Ft Studio Layout: Sleep, Work and Storage Zones | RoomFeng', description: 'Compare three dimension-validated studio zoning strategies for a compact open-plan home.', heading: 'A 300 sq ft studio is a zoning problem', lead: 'The same floor area can feel open, work-ready, or storage-heavy depending on where the sleeping zone ends. Start with a zoning strategy instead of placing furniture at random.', answer: 'A 300 sq ft studio is roughly 27.9 m², but the usable rectangle may be smaller once kitchen runs, bathroom walls and entry routes are removed. The studio records below are open-room anchors, not a full apartment plan.', geometry: 'The approved studio anchors use 5600 × 5000 mm for a micro studio and 6100 × 6100 mm for a small studio. Measure the actual open area and fixed elements before applying a layout.', strategy: 'Open-space leaves the centre flexible, work-first gives the desk a reliable home, and sleep-privacy creates a stronger visual separation.', tradeoff: 'More privacy usually means less open floor; a work-first zone can make hosting less spontaneous.', assumptions: 'These records assume an open rectangle. Kitchen, bath, columns and radiators are not silently included; redraw them in the free Planner.', ids: ['ST-MICRO-001', 'ST-MICRO-002', 'ST-MICRO-003'] },
};
export function getStaticPaths() { return ['10x10-bedroom-layout', '10x12-bedroom-queen-desk', '3x3m-bedroom-layout', '3x3-6m-bedroom-layout', 'narrow-bedroom-layout', '300-sq-ft-studio-layout'].map((slug) => ({ params: { slug } })); }
const guide = guides[Astro.params.slug ?? '10x10-bedroom-layout'];
const layouts = guide.ids.map((id) => approvedLayouts.find((layout) => layout.id === id)).filter(Boolean) as LayoutRecord[];
const canonical = `/en/layout-guides/${Astro.params.slug}/`;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.description, inLanguage: 'en', url: `${siteUrl}${canonical}`, author: { '@type': 'Organization', name: 'RoomFeng' } }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` }, { '@type': 'ListItem', position: 2, name: 'Layout guides', item: `${siteUrl}/en/layout-guides/` }, { '@type': 'ListItem', position: 3, name: guide.heading, item: `${siteUrl}${canonical}` }] }];
---
<Layout title={guide.title} description={guide.description} canonical={canonical} lang="en" alternates={{ en: canonical, zh: `/zh/layout-guides/${Astro.params.slug}/` }} jsonLd={jsonLd} pageType="guide" showAffiliateRecs={false}>
  <section class="layout-guide"><div class="container">
    <header class="layout-guide-header"><p class="layout-guide-kicker">ROOMFENG / LAYOUT GUIDE</p><h1>{guide.heading}</h1><p class="layout-guide-lead">{guide.lead}</p></header>
    <div class="layout-guide-grid"><article class="layout-guide-main"><p><strong>Quick answer:</strong> {guide.answer}</p><div class="layout-guide-callout"><strong>Geometry first.</strong> {guide.geometry}</div><h2>Compare the actual strategies</h2><div class="layout-guide-plan-grid">{layouts.map((layout) => <figure class="layout-guide-plan"><div set:html={renderLayoutSvg(layout, { locale: 'en', mode: 'simple' })}></div><figcaption>{layout.archetype} · {layout.roomWidthMm} × {layout.roomLengthMm} mm</figcaption></figure>)}</div><h2>What changes between them?</h2><p>{guide.strategy}</p><p><strong>Trade-off:</strong> {guide.tradeoff}</p><h2>Before you move anything</h2><p>{guide.assumptions} Measure the outside of every bed frame, desk, wardrobe and chair operating zone. A mattress preset is only an anchor.</p><div class="layout-guide-cta" data-product-cta-view={`guide_${Astro.params.slug}_after_tradeoff`}><p><strong>Ready to test your actual room?</strong> Use the free matcher first, then compare every validated strategy in Layout Vault.</p><p><a href="/en/room-layout-matcher/" data-product-cta="guide_matcher">Try your room in the free matcher</a></p></div></article><aside class="layout-guide-aside"><h2>Use this page with</h2><dl class="layout-guide-facts"><div><dt>Best next step</dt><dd>Enter your real room dimensions</dd></div><div><dt>Included records</dt><dd>{layouts.length} approved strategies</dd></div><div><dt>Units</dt><dd>Millimetres, centimetres or ft/in</dd></div></dl><h2>Continue planning</h2><nav class="layout-guide-links"><a href="/en/room-layout-planner/">Free RoomFeng Planner</a><a href="/en/small-space-layout-vault/" data-product-cta="guide_vault">All Layout Vault features</a><a href="/en/layout-guides/10x12-bedroom-queen-desk/">Related: 10 × 12 comparison</a></nav></aside></div>
  </div></section>
</Layout>

<script>
  import { trackProductEvent } from '../../../moving-os/productAnalytics';
  const locale = 'en';
  const productId = 'roomfeng-layout-vault-v1';
  document.querySelectorAll<HTMLElement>('[data-product-cta-view]').forEach((element) => trackProductEvent('product_cta_view', element.dataset.productCtaView || 'guide_after_tradeoff', locale, { product_id: productId }));
  document.querySelectorAll<HTMLElement>('[data-product-cta]').forEach((element) => element.addEventListener('click', () => trackProductEvent('product_cta_click', element.dataset.productCta || 'guide_cta', locale, { product_id: productId })));
</script>
