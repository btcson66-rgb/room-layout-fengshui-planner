---
import Layout from '../../components/Layout.astro';
import LayoutVault from '../../components/LayoutVault.astro';
import { approvedLayouts } from '../../small-space/approved-layouts';

const title = 'Layout Vault | Dimension-validated room layouts | RoomFeng';
const description = 'Match your room to curated, dimension-validated bedroom and studio layouts, compare strategies, and hand off a starting point to the free RoomFeng Planner.';
const canonical = '/en/layout-vault/';
const alternates = { en: canonical, zh: '/zh/layout-vault/' };
---

<Layout title={title} description={description} canonical={canonical} lang="en" alternates={alternates} noindex pageType="tool" showAffiliateRecs={false}>
  <section class="section layout-vault-section">
    <div class="container">
      <LayoutVault layouts={approvedLayouts} locale="en" />
    </div>
  </section>
</Layout>
