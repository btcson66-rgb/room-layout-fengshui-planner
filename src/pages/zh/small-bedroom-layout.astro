---
import Layout from '../../components/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateRecs from '../../components/AffiliateRecs.astro';
import Faq from '../../components/Faq.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

const title = '小房間配置指南｜床、書桌、衣櫃怎麼放才不擠';
const description = '小房間家具配置建議，說明床、書桌、衣櫃、門窗與走道間距怎麼安排，並用線上規劃器先畫出可用版本。';
const canonical = '/zh/small-bedroom-layout/';
const alternates = { zh: '/zh/small-bedroom-layout/', en: '/en/small-bedroom-layout-planner/' };
const siteUrl = 'https://roomfeng.win';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: '小房間配置指南',
    description,
    inLanguage: 'zh-TW',
    author: { '@type': 'Organization', name: 'RoomFeng' },
    mainEntityOfPage: `${siteUrl}${canonical}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '小房間配置', item: `${siteUrl}${canonical}` },
    ],
  },
];
const faq = [
  { q: '小房間床一定要靠牆嗎？', a: '多數小房間會把床靠牆以節省走道，但仍要考慮上下床、換床單、插座與窗簾使用是否方便。' },
  { q: '書桌放窗邊好嗎？', a: '窗邊採光好，但要注意日曬、反光、窗簾開合與冷氣位置；若會長時間工作，桌前與椅後空間更重要。' },
  { q: '衣櫃前方要留多少？', a: '要看門片或抽屜形式。平開門與抽屜需要更多前方距離，拉門衣櫃較省空間，但仍要能站著拿衣物。' },
  { q: '可以用風水決定小房間配置嗎？', a: '可作為民俗與舒適度參考，但不應取代尺寸、安全、採光、通風與日常使用需求；本站不保證任何結果。' },
];
const relatedLinks = [
  { href: '/zh/bed-desk-wardrobe-layout/', title: '床桌衣櫃配置' },
  { href: '/zh/furniture-fit-checker/', title: '家具尺寸適配檢查' },
  { href: '/zh/storage-bed-selector/', title: '收納床／掀床選型規劃器' },
  { href: '/zh/room-size-layout-templates/', title: '3～8 坪房間配置範本' },
  { href: '/zh/rental-room-layout/', title: '租屋房間配置' },
  { href: '/zh/room-layout-planner/', title: '房間配置規劃器' },
];
const relatedArticles = [
  { href: '/zh/blog/small-bedroom-bed-placement/', title: '小房間床位擺放' },
  { href: '/zh/blog/small-room-storage-zones/', title: '小房間收納分區' },
  { href: '/zh/blog/nordic-small-room-layout/', title: '北歐風小房間配置' },
  { href: '/zh/blog/tatami-platform-bedroom/', title: '和室架高臥室配置' },
];
---

<Layout title={title} description={description} canonical={canonical} lang="zh" alternates={alternates} jsonLd={jsonLd}>
  <section class="section">
    <div class="container page-grid">
      <article class="card">
        <h1>小房間配置指南</h1>
        <p class="lead">小房間不是只能把家具塞滿，而是要先保留每天會用到的走道、開門、坐下與收納動作。</p>
        <p>小臥室最常見的問題，是床、書桌、衣櫃三件家具各自尺寸都合理，放在一起卻互相打架。床擺下後衣櫃門打不開，書桌椅子一拉就撞到床尾，門口進來第一步就被床角擋住。要讓小房間好用，第一步不是找最漂亮的擺法，而是把必要動作列出來：進門、上下床、坐到桌前、打開衣櫃、拿行李、打掃地面。只要其中一個動作每天都卡，房間就會很快變亂。</p>
        <p>規劃時可以先決定床的位置，因為床通常最大，也最不容易頻繁移動。單人床可考慮長邊靠牆，雙人床若兩人使用，至少要思考其中一側上下床是否可接受。書桌最好接近插座與自然光，但不要讓椅背完全堵住主要通道。衣櫃若是平開門，要把門片打開的弧度或深度算進去；若是拉門衣櫃，也要留站立與拿衣服的距離。窗戶附近不要被高櫃完全擋住，以免通風與採光變差。</p>
        <p>若你還沒有家具配置起點，可先用 <a href="/zh/room-size-layout-templates/">3～8坪房間配置範本</a> 依坪數比較睡眠、讀書、收納或上下舖需求，再把較合適的範本帶進規劃器細調。</p>

        <h2>小房間常用間距</h2>
        <p>主要走道可用約 60 公分作為基本參考，若只能留更窄，要確認不是每天頻繁通過的位置。床尾到牆或衣櫃之間若低於可自然側身通過的寬度，換床單和打掃會比較辛苦。書桌前方要能坐下、拉椅、站起來，衣櫃前方要能蹲下或彎腰拿物。小房間可以接受局部緊湊，但不要讓門口、床邊、桌前和衣櫃前全部同時緊。</p>

        <h2>3 坪、4 坪、6 坪的實測尺寸情境</h2>
        <p>以下都用矩形房的室內淨尺寸計算，不把牆厚、樑柱或櫃體算成可用面積。數字的用途是先判斷「這組家具是否值得畫進平面圖」，不是保證任何同坪數房間都能照放；只要門窗位置不同，就要在<a href="/zh/room-layout-planner/">規劃器</a>重新排一次。</p>

        <h3>3 坪：約 248 × 400 公分，單人睡眠＋窄桌</h3>
        <p>採 90 × 188 公分標準單人床靠長牆，對牆放 100 × 45 公分窄桌，床沿到桌沿的固定淨寬是 248－90－45＝113 公分。椅子向後使用 55 公分時，仍剩約 58 公分可通過；這條路徑已接近 60 公分基本參考，不宜再把 60 公分深標準書桌換進來，否則椅子拉出後只剩 43 公分。</p>
        <p>衣物收納可放在床尾外的長邊餘量：400－188＝212 公分。選 90 寬 × 50 深公分拉門衣櫃後，仍要在平面圖確認它沒有占到房門開啟區；若床下也要收納，先用<a href="/zh/storage-bed-selector/">收納床／掀床選型規劃器</a>比較抽屜全拉與掀床操作空間，不能只看床架關閉尺寸。</p>

        <h3>4 坪：約 287 × 460 公分，加大單人床＋工作桌</h3>
        <p>採 105 × 188 公分加大單人床靠長牆，對牆放 120 × 50 公分桌，固定淨寬是 287－105－50＝132 公分。椅子向後抓 60 公分後，尚有 72 公分通行；即使椅子正在使用，也比 3 坪情境多 14 公分。床尾可放 120 寬 × 60 深公分衣櫃，但衣櫃若是平開門，還要把約 50～60 公分門片開啟深度畫出來，不能讓門片與桌椅區重疊。</p>
        <p>若房間短邊實量不到 287 公分，直接代入「短邊－105－50－60」計算椅後通道；結果低於 60 公分時，先把桌深降到 45 公分或改成床尾書桌，不要靠縮小椅子活動區掩蓋問題。</p>

        <h3>6 坪：約 347 × 570 公分，雙人床＋兩側上下床</h3>
        <p>採 150 × 190 公分雙人床，床頭靠 347 公分短牆並左右置中，兩側各剩（347－150）÷ 2＝98.5 公分，可讓兩人分別上下床。床尾到對牆尚有 570－190＝380 公分；在對面放 180 寬 × 60 深公分衣櫃後，床尾到櫃前仍有 320 公分，足以再分出 120 × 60 公分書桌區，但桌椅與衣櫃門的操作區不可重疊。</p>
        <p>這個版本把「兩側都能上下床」列為優先，因此比雙人床側靠牆更適合兩人長期共用。若門開在床側或房內有深柱，請量障礙物後的最窄短邊；任一床側低於 60 公分，就不能再沿用 98.5 公分的計算結果。</p>

        <h2>這個小房間配置不適合誰？</h2>
        <ul>
          <li><strong>需要兩人共用，但房間短邊不足 270 公分：</strong>150 公分雙人床加兩側各 60 公分基本通道，最低就要 270 公分；不足時代表至少一側會被壓縮，不適合直接照單人靠牆版本。</li>
          <li><strong>需要獨立書房等級的桌面：</strong>60 公分深桌面加 75 公分椅後操作區，工作帶約需 135 公分。若床沿到對牆沒有 195 公分（135 公分工作帶＋60 公分通道），本頁的窄桌情境不等於獨立書房。</li>
          <li><strong>有樑柱、斜牆或內凹窗臺：</strong>計算必須用障礙物之間的最窄淨寬。原本 72 公分椅後通道若被 15 公分柱角吃掉，就只剩 57 公分，應重新排床桌方向。</li>
          <li><strong>需要無障礙通行或大型輔具迴轉：</strong>本頁的 60 公分只是一般小房間初篩值，不足以代表輪椅路徑或迴轉需求；應依使用者輔具實測與所在地要求另做規劃。</li>
        </ul>
        <p>若你只有坪數、還沒有房間比例，先用<a href="/zh/room-size-layout-templates/">3～8 坪房間配置範本</a>挑起點；若已看中床架，直接用<a href="/zh/storage-bed-selector/">收納床／掀床選型規劃器</a>檢查開啟區。兩者都不能取代最後的實際淨長寬與門窗定位。</p>

        <h2>如何用規劃器檢查小房間</h2>
        <ol>
          <li>先在 <a href="/zh/room-layout-planner/">規劃器</a> 輸入房間內部長寬，加入門窗位置。</li>
          <li>放入床，確認床邊或床尾至少有一條可行走路線。</li>
          <li>加入書桌與椅子活動範圍，避免桌椅擋住房門或衣櫃。</li>
          <li>加入衣櫃，依門片形式預留前方操作距離。</li>
          <li>比較兩到三個版本，再選擇最符合日常動作的配置。</li>
        </ol>
        <p>若你也想看中文民俗格局參考，例如床是否直接面向門、床頭是否靠牆，請以「常見說法」與空間舒適度角度看待，並參考 <a href="/disclaimer/">免責聲明</a>。小房間真正的核心仍是通行安全、收納效率和生活習慣。</p>
      </article>
      <div class="cta-band">
        <div>
          <h2>把小房間先畫出來</h2>
          <p>先放最大件家具，再一步步確認桌前、床邊與衣櫃前的可用距離。</p>
        </div>
        <a class="button" href="/zh/room-layout-planner/">開始配置小房間</a>
      </div>
      <AdSlot id="zh-small-bedroom-mid" adSlot="zh-small-bedroom-mid" />
      <section class="card" aria-labelledby="related-articles-heading">
        <h2 id="related-articles-heading">相關文章</h2>
        <ul>
          {relatedArticles.map((a) => <li><a href={a.href}>{a.title}</a></li>)}
        </ul>
      </section>
      <AffiliateRecs productIds={['fengshui-mousepad', 'white-crystal-cluster']} />
      <Faq items={faq} />
      <RelatedLinks links={relatedLinks} />
    </div>
  </section>
</Layout>
