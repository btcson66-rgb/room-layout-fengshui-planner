---
import Layout from '../../../components/Layout.astro';
import { approvedLayouts } from '../../../small-space/approved-layouts';
import { renderLayoutSvg } from '../../../small-space/renderer';
import '../../../styles/layout-guide.css';
import type { LayoutRecord } from '../../../small-space/types';

const siteUrl = 'https://roomfeng.win';
const guides: Record<string, { title: string; description: string; heading: string; lead: string; answer: string; geometry: string; strategy: string; tradeoff: string; assumptions: string; ids: string[] }> = {
  '10x10-bedroom-layout': { title: '10×10 英尺臥室格局：雙人床、書桌與動線｜RoomFeng', description: '比較三個 10×10 英尺、經過尺寸驗證的臥室起點，理解床位、工作區與動線取捨。', heading: '10 × 10 英尺臥室，要先決定誰優先', lead: '正方形不代表每種排法都一樣。你要先決定床邊進出、工作面，還是中央留白是最重要的日常需求。', answer: '10 × 10 英尺約為 3048 × 3048 mm。雙人床與書桌是否真的好用，要把床架、拉出的椅子與實際通道都算進來；先從驗證過的策略開始，再換成你要買的家具尺寸。', geometry: '正方形核准範本為 3000 × 3000 mm；10 × 12 英尺範本則是 3048 × 3658 mm，不能直接把較長房間的動線照搬到真正的 10 × 10。', strategy: '置中床位、工作優先、中央開放分別保護不同生活情境：雙側進出、穩定工作牆、或單人房的彈性地板。', tradeoff: '書桌椅與收納牆越完整，另一側床邊通常越需要接受較緊的進出。', assumptions: '門窗位置沿用各格局紀錄的範本假設；補上實際開口後，才是你的可執行版本。', ids: ['BR-SQ-001', 'BR-SQ-002', 'BR-SQ-003'] },
  '10x12-bedroom-queen-desk': { title: '10×12 英尺臥室如何放雙人床與書桌｜RoomFeng', description: '用三個真實 10×12 英尺格局比較工作、收納與床邊動線。', heading: '10 × 12 英尺臥室的多出兩英尺怎麼用？', lead: '多出的長度可以留給工作區、收納牆，或比較舒服的床邊路徑；答案取決於你每天怎麼使用房間。', answer: '10 × 12 英尺約為 3048 × 3658 mm。以下三個核准範本共享同一個房間尺寸，卻提供不同策略，讓你比較工作可用性、床邊進出與收納。', geometry: '這組範本使用 3048 × 3658 mm。床墊尺寸不是床架外框；請把床架外擴、椅子拉出與衣櫃開門深度都保留。', strategy: '明亮動線保護入口路徑，收納牆集中衣物，平衡方案則把台灣 5 尺床、書桌與衣櫃放在可執行的折衷中。', tradeoff: '中央路徑越清楚，單側床邊可能越緊；收納牆越完整，工作區靠近入口時越要注意轉身。', assumptions: '資料中的門窗是假設，不是現場測量；入住前請在 Planner 補上實際牆面開口。', ids: ['BR-1012-001', 'BR-1012-002', 'BR-1012-003'] },
  '3x3m-bedroom-layout': { title: '3×3 公尺臥室格局：床、書桌與收納怎麼排｜RoomFeng', description: '比較三個 3000 × 3000 mm 臥室起點，依睡眠、工作與中央留白做選擇。', heading: '3 × 3 公尺臥室，先做優先順序練習', lead: '9 平方公尺很容易把所有願望一起塞進去，結果每天的路徑先失效。先選兩個最重要的需求，再挑有明確取捨的格局。', answer: '3000 × 3000 mm 的核准範本包括置中雙人床、工作優先雙人床，以及 Full 床搭配彈性書桌。它們不是同一張圖的微調，而是三種生活順序。', geometry: '三個範本都是 3000 × 3000 mm 清楚矩形；請把踢腳板、暖氣、衣櫃門與床架外框從可用尺寸扣除。', strategy: '置中床位適合重視雙側進出的伴侶，工作優先保護固定書桌，中央開放則保留單人生活的彈性。', tradeoff: '雙人床越大，剩餘動線越少；彈性版本通常需要放棄部分收納確定性。', assumptions: '格局使用各自的門窗場景假設，仍須在免費 Planner 重新核對固定物。', ids: ['BR-SQ-001', 'BR-SQ-002', 'BR-SQ-003'] },
  '3x3-6m-bedroom-layout': { title: '3×3.6 公尺臥室格局比較｜RoomFeng', description: '比較三個 2700 × 3600 mm 臥室策略，理解雙人床、書桌、衣櫃與進出路徑。', heading: '3 × 3.6 公尺，把長度留給分區', lead: '2700 × 3600 mm 足以把睡眠與工作分成兩個帶狀區域，但入口路徑不能被當成剩餘空間。', answer: '三個中型範本分別是雙人床優先、書桌優先 Queen，以及收納優先雙人床。請依日常作息，而不是只看哪張圖最漂亮來選。', geometry: '房間基準為 2700 × 3600 mm，比 3 × 3 m 多 600 mm 長度；這足以改變端區策略，卻仍不足以忽略椅子拉出空間。', strategy: '雙人床優先讓衣櫃牆穩定，書桌優先保護工作牆，收納優先則讓床尾留出較大的開放感。', tradeoff: '分區清楚可能讓收納路徑變長；集中收納則會讓入口一側更緊。', assumptions: '使用資料中的矩形與門窗假設；安裝前請補入實際門扇方向與窗戶位置。', ids: ['BR-MN-001', 'BR-MN-002', 'BR-MN-003'] },
  'narrow-bedroom-layout': { title: '狹長臥室格局：單人床、書桌與清楚動線｜RoomFeng', description: '比較三個 2400 × 3600 mm 狹長臥室策略，不把正方形排法硬套進去。', heading: '狹長房間要先決定長牆用途', lead: '狹長臥室不是把所有家具轉向就能解決。以下三個範本把 2400 mm 寬度攤開，誠實說明每種動線代價。', answer: '2400 × 3600 mm 的狹長範本可放單人床，並分成長牆床位、端牆工作區、線性收納加工作角三種日常模式。', geometry: '狹長基準為 2400 × 3600 mm；資料中的單人床約 990 × 1905 mm，但床架、拉椅與門扇都會再吃掉空間。', strategy: '長牆床位保護主要通道，端牆方案給工作一個獨立位置，線性收納則讓中央路徑更容易讀懂。', tradeoff: '工作區版本會壓縮其中一側進出；收納版本則要求中央通道保持整潔。', assumptions: '門窗位置是範本假設；暖氣或向內開的門，都可能讓 Strong Match 降成需要複核。', ids: ['BR-N-001', 'BR-N-002', 'BR-N-003'] },
  '300-sq-ft-studio-layout': { title: '300 平方英尺套房格局：睡眠、工作與收納分區｜RoomFeng', description: '比較小型開放式套房的三種尺寸驗證分區策略，理解睡眠、工作與收納如何取捨。', heading: '300 平方英尺套房，本質上是分區問題', lead: '同樣的面積，睡眠區放在哪裡，會決定空間看起來開闊、適合工作，或收納優先。先選分區策略，再放家具。', answer: '300 平方英尺約 27.9 m²，但實際可用矩形通常還要扣掉廚房、浴室與入口。以下套房範本是開放區起點，不是完整房屋平面圖。', geometry: '核准套房範本使用 5600 × 5000 mm 與 6100 × 6100 mm。請量實際開放區與固定設備後再套用。', strategy: '開放空間保留中央彈性，工作優先給書桌穩定位置，睡眠隱私則建立較明顯的視覺分隔。', tradeoff: '隱私越強，中央開放地板通常越少；工作優先也可能讓招待客人不那麼即興。', assumptions: '範本假設是開放矩形，不會暗中把廚房、浴室、柱子算進來；請在 Planner 重畫固定物。', ids: ['ST-MICRO-001', 'ST-MICRO-002', 'ST-MICRO-003'] },
};
export function getStaticPaths() { return ['10x10-bedroom-layout', '10x12-bedroom-queen-desk', '3x3m-bedroom-layout', '3x3-6m-bedroom-layout', 'narrow-bedroom-layout', '300-sq-ft-studio-layout'].map((slug) => ({ params: { slug } })); }
const guide = guides[Astro.params.slug ?? '10x10-bedroom-layout'];
const layouts = guide.ids.map((id) => approvedLayouts.find((layout) => layout.id === id)).filter(Boolean) as LayoutRecord[];
const canonical = `/zh/layout-guides/${Astro.params.slug}/`;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.description, inLanguage: 'zh-TW', url: `${siteUrl}${canonical}`, author: { '@type': 'Organization', name: 'RoomFeng' } }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}/zh/` }, { '@type': 'ListItem', position: 2, name: '格局指南', item: `${siteUrl}/zh/layout-guides/` }, { '@type': 'ListItem', position: 3, name: guide.heading, item: `${siteUrl}${canonical}` }] }];
---
<Layout title={guide.title} description={guide.description} canonical={canonical} lang="zh" alternates={{ en: `/en/layout-guides/${Astro.params.slug}/`, zh: canonical }} jsonLd={jsonLd} pageType="guide" showAffiliateRecs={false}>
  <section class="layout-guide"><div class="container">
    <header class="layout-guide-header"><p class="layout-guide-kicker">ROOMFENG / 格局指南</p><h1>{guide.heading}</h1><p class="layout-guide-lead">{guide.lead}</p></header>
    <div class="layout-guide-grid"><article class="layout-guide-main"><p><strong>快速結論：</strong>{guide.answer}</p><div class="layout-guide-callout"><strong>先看尺寸。</strong>{guide.geometry}</div><h2>比較真正不同的策略</h2><div class="layout-guide-plan-grid">{layouts.map((layout) => <figure class="layout-guide-plan"><div set:html={renderLayoutSvg(layout, { locale: 'zh', mode: 'simple' })}></div><figcaption>{layout.archetype} · {layout.roomWidthMm} × {layout.roomLengthMm} mm</figcaption></figure>)}</div><h2>三個版本差在哪裡？</h2><p>{guide.strategy}</p><p><strong>取捨：</strong>{guide.tradeoff}</p><h2>開始搬動前</h2><p>{guide.assumptions} 請量床架、書桌、衣櫃的最大外框，也要把椅子拉出與抽屜開啟區算進來；床墊 preset 只是規劃錨點。</p><div class="layout-guide-cta" data-product-cta-view={`guide_${Astro.params.slug}_after_tradeoff`}><p><strong>想用你的實際房間試試嗎？</strong> 先用免費配對，再到 Layout Vault 比較所有符合的策略。</p><p><a href="/zh/room-layout-matcher/" data-product-cta="guide_matcher">用免費配對工具輸入你的房間</a></p></div></article><aside class="layout-guide-aside"><h2>這頁適合搭配</h2><dl class="layout-guide-facts"><div><dt>下一步</dt><dd>輸入實際房間尺寸</dd></div><div><dt>核准範本</dt><dd>{layouts.length} 個不同策略</dd></div><div><dt>單位</dt><dd>mm、cm 或英制 ft/in</dd></div></dl><h2>繼續規劃</h2><nav class="layout-guide-links"><a href="/zh/room-layout-planner/">免費 RoomFeng 房間規劃器</a><a href="/zh/small-space-layout-vault/" data-product-cta="guide_vault">查看完整小空間格局庫</a><a href="/zh/layout-guides/10x12-bedroom-queen-desk/">相關：10 × 12 英尺比較</a></nav></aside></div>
  </div></section>
</Layout>

<script>
  import { trackProductEvent } from '../../../moving-os/productAnalytics';
  const locale = 'zh-TW';
  const productId = 'roomfeng-layout-vault-v1';
  document.querySelectorAll<HTMLElement>('[data-product-cta-view]').forEach((element) => trackProductEvent('product_cta_view', element.dataset.productCtaView || 'guide_after_tradeoff', locale, { product_id: productId }));
  document.querySelectorAll<HTMLElement>('[data-product-cta]').forEach((element) => element.addEventListener('click', () => trackProductEvent('product_cta_click', element.dataset.productCta || 'guide_cta', locale, { product_id: productId })));
</script>
