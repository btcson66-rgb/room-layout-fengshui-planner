---
import Layout from '../../components/Layout.astro';
import LayoutVaultSales from '../../components/LayoutVaultSales.astro';
import { layoutVaultProduct } from '../../config/products';
import { approvedLayouts } from '../../small-space/approved-layouts';

const title = 'RoomFeng 小空間格局庫｜臥室與套房尺寸配對規劃工具';
const description = '輸入實際房間尺寸、床型、家具與生活需求，直接比較經過尺寸驗證的臥室與套房配置策略，不必從空白平面圖開始。';
const canonical = '/zh/small-space-layout-vault/';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Product', name: layoutVaultProduct.shortName, description, brand: { '@type': 'Brand', name: 'RoomFeng' }, category: '房間格局規劃工具', offers: { '@type': 'Offer', price: layoutVaultProduct.price.amount.toFixed(2), priceCurrency: layoutVaultProduct.price.currency, availability: 'https://schema.org/OnlineOnly', url: `https://roomfeng.win${canonical}` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首頁', item: 'https://roomfeng.win/zh/' }, { '@type': 'ListItem', position: 2, name: layoutVaultProduct.shortName, item: `https://roomfeng.win${canonical}` }] },
];
---

<Layout title={title} description={description} canonical={canonical} lang="zh" alternates={{ en: '/en/small-space-layout-vault/', zh: canonical }} jsonLd={jsonLd} pageType="tool" showAffiliateRecs={false}>
  <LayoutVaultSales locale="zh" previewHref={layoutVaultProduct.previewPaths.zh} plannerHref="/zh/room-layout-planner/" samplePackHref={layoutVaultProduct.packageDownload} providers={layoutVaultProduct.providers} layouts={approvedLayouts} supportEmail={layoutVaultProduct.supportEmail} refundPolicyUrl={layoutVaultProduct.refundPolicyUrl} />
</Layout>
