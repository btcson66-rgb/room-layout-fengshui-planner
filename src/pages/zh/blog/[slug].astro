---
import { getCollection, render } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import NewsletterSignup from '../../../components/NewsletterSignup.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import AffiliateRecs from '../../../components/AffiliateRecs.astro';
import PlannerCta from '../../../components/PlannerCta.astro';
import { hubContent } from '../../../data/hubs';
import { isReviewReadyBlogSlug, reviewReadyCategorySlugs } from '../../../data/contentQuality.mjs';
import { categoryMeta, formatDate, siteUrl } from '../../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = `/zh/blog/${post.id}/`;
const category = categoryMeta[post.data.category];
const reviewReady = !post.data.noindex && isReviewReadyBlogSlug(post.id);
const authorName = 'Btcson Project 編輯團隊';
const authorPath = '/about/#btcson-project-team';
const articleAuthor = {
  '@type': 'Organization',
  name: authorName,
  url: `${siteUrl}${authorPath}`,
};
const blogPosts = await getCollection('blog');
const blogTitleBySlug = new Map(
  blogPosts.filter((entry) => !entry.data.noindex && isReviewReadyBlogSlug(entry.id)).map((entry) => [entry.id, entry.data.title]),
);
const TOOL_TITLES: Record<string, string> = {
  '/zh/room-layout-planner/': '房間家具配置工具',
  '/zh/furniture-fit-checker/': '家具尺寸檢查',
  '/zh/small-bedroom-layout/': '小房間佈局規劃',
  '/zh/studio-apartment-layout/': '小套房配置',
  '/zh/bed-desk-wardrobe-layout/': '床桌衣櫃配置',
  '/zh/rental-room-layout/': '租屋房間配置',
  '/zh/moving-furniture-size-check/': '搬家家具尺寸檢查',
  '/zh/feng-shui-bedroom-checker/': '臥室風水格局檢查',
  '/zh/beam-layout-fix-check/': '樑下配置化解檢查器',
  '/zh/bedroom-feng-shui-layout/': '臥室風水配置',
  '/zh/living-room-furniture-layout/': '客廳家具配置',
  '/zh/small-room-storage-planner/': '小房間收納規劃',
  '/zh/room-furniture-size-advisor/': '房間家具尺寸建議',
  '/zh/room-size-layout-templates/': '房型配置範本',
  '/zh/storage-bed-selector/': '收納床選擇器',
  '/zh/desk-placement-feng-shui/': '書桌位置風水',
  '/zh/bed-door-fix-selector/': '床對門化解選擇器',
  '/zh/desk-door-fix-check/': '書桌對門化解檢查',
  '/zh/mirror-facing-bed-feng-shui/': '鏡子對床風水',
  '/zh/blog/': '房間規劃文章',
};

// 只輸出能解析出真實標題的連結：未知路徑一律丟棄，
// 避免把原始網址當成錨文字（曾造成 /zh/room-circulation-check/ 之類的 404 連結）。
const resolveRelatedTool = (href: string) => {
  const mapped = TOOL_TITLES[href];
  if (mapped) return { href, title: mapped };
  const blogMatch = href.match(/^\/zh\/blog\/([^/]+)\/$/);
  if (blogMatch) {
    const title = blogTitleBySlug.get(blogMatch[1]);
    if (title) return { href, title };
  }
  return null;
};
const relatedPostLinks = post.data.relatedPosts
  .map((slug: string) => {
    const title = blogTitleBySlug.get(slug);
    return title ? { href: `/zh/blog/${slug}/`, title } : null;
  })
  .filter((link): link is { href: string; title: string } => link !== null);
// 每篇文章都要有一個具體的工具入口。preset 用分類對應到最接近的房型範例，
// CTA 文案則依 tag/標題裡真正出現的家具決定，避免千篇一律的「開啟工具」。
const plannerPreset = hubContent[post.data.category]?.plannerPreset ?? 'studio';
const ctaSubjects = [
  { pattern: /床|寢具|睡/, label: '床' },
  { pattern: /書桌|工作|辦公|螢幕/, label: '書桌' },
  { pattern: /衣櫃|收納|櫃/, label: '衣櫃與收納' },
  { pattern: /門|玄關|出入/, label: '門片開啟範圍' },
  { pattern: /窗|採光|窗簾/, label: '窗戶' },
  { pattern: /鏡/, label: '鏡子' },
  { pattern: /樑|梁/, label: '樑的投影' },
  { pattern: /沙發|客廳/, label: '沙發' },
];
const ctaHaystack = [post.data.title, post.data.description, ...post.data.tags].join(' ');
const ctaMatched = ctaSubjects.filter((subject) => subject.pattern.test(ctaHaystack)).map((subject) => subject.label);
const ctaItems = (ctaMatched.length > 0 ? ctaMatched : ['床', '書桌', '門片開啟範圍']).slice(0, 3);
const plannerCtaText = `照這篇量到的尺寸，用 Room Planner 把${ctaItems.join('、')}的位置畫進平面圖，工具會即時檢查走道寬度、門口是否被擋住，並列出床對門、鏡子對床等格局提醒。`;

const relatedLinks = [
  ...post.data.relatedTools
    .map((href: string) => resolveRelatedTool(href))
    .filter((link): link is { href: string; title: string } => link !== null),
  ...relatedPostLinks,
  ...(reviewReadyCategorySlugs.has(post.data.category)
    ? [{ href: `/zh/category/${post.data.category}/`, title: category?.title ?? post.data.category }]
    : []),
];
const body = (post.body ?? '').replace(/\r\n/g, '\n');
// FAQ 區塊必須在「下一個 ## 標題」就結束。
// 之前的寫法把 `## 常見問題` 之後的**整份剩餘內文**都當成 FAQ 來掃 `###`，
// 於是「## 相關工具與延伸閱讀 / ### 參考資料」被當成一組問答塞進 FAQPage：
// 283 篇文章因此輸出了一個畫面上不是問答的「參考資料」Question。
// Schema 必須與畫面一致，所以這裡先把區塊切乾淨再抽問答。
const faqHeading = body.match(/^##\s*(?:常見問題|FAQ).*$/m);
const faqSectionBody = faqHeading
  ? body.slice((faqHeading.index ?? 0) + faqHeading[0].length).split(/\n##\s+/)[0]
  : '';
const faqMatches = [...faqSectionBody.matchAll(/###\s+(.+?)\n\n([\s\S]*?)(?=\n###|$)/g)]
  .filter((match) => match[1] && match[2])
  .slice(0, 6)
  .map((match) => ({
    q: match[1].trim(),
    a: match[2].replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[#*_`>-]/g, '').trim(),
  }));
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.updated.toISOString(),
    author: articleAuthor,
    inLanguage: 'zh-TW',
    mainEntityOfPage: `${siteUrl}${canonical}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '文章', item: `${siteUrl}/zh/blog/` },
      { '@type': 'ListItem', position: 3, name: category?.title ?? post.data.category, item: `${siteUrl}/zh/category/${post.data.category}/` },
      { '@type': 'ListItem', position: 4, name: post.data.title, item: `${siteUrl}${canonical}` },
    ],
  },
];
if (faqMatches.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqMatches.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
if (post.data.howToSteps.length > 0) {
  const howTo: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: post.data.howToName ?? post.data.title,
    step: post.data.howToSteps.map((text: string, index: number) => ({
      '@type': 'HowToStep',
      position: index + 1,
      text,
    })),
  };
  if (post.data.howToTotalTime) howTo.totalTime = post.data.howToTotalTime;
  jsonLd.push(howTo);
}
---

<Layout title={`${post.data.title}｜RoomFeng`} description={post.data.description} canonical={canonical} lang="zh" ogType="article" jsonLd={jsonLd} noindex={!reviewReady}>
  <article class="section">
    <div class="container page-grid">
      <header class="card article-meta">
        <p><a href="/zh/blog/">文章</a> / <a href={`/zh/category/${post.data.category}/`}>{category?.title ?? post.data.category}</a></p>
        <p class="lead">{post.data.description}</p>
        <p class="byline">
          作者：<a href={authorPath}>{authorName}</a> ·
          發布時間：<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> ·
          更新時間：<time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time>
        </p>
        <p class="tag-list">{post.data.tags.map((tag: string) => <span>{tag}</span>)}</p>
        {(post.data.category === 'feng-shui' || body.includes('風水')) && (
          <p class="disclaimer-note">
            本文風水內容僅供民俗文化與空間配置參考；不保證健康、財運、感情、事業或任何人生結果，也不取代專業建築、室內設計、醫療或法律建議。請以實際居住安全、動線、採光、通風與個人需求為準，並閱讀 <a href="/disclaimer/">免責聲明</a>。
          </p>
        )}
      </header>

      {reviewReady && <AdSlot id="zh-blog-top" adSlot="zh-blog-top" />}

      <div class="card article-body">
        <Content />
      </div>

      <PlannerCta preset={plannerPreset} text={plannerCtaText} />

      {reviewReady && <AffiliateRecs category={post.data.category} tags={post.data.tags} slug={post.id} />}

      {reviewReady && <AdSlot id="zh-blog-bottom" adSlot="zh-blog-bottom" />}

      {reviewReady && <NewsletterSignup placement="article" />}

      <RelatedLinks links={relatedLinks} />
    </div>
  </article>
</Layout>

<style>
  .page-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .article-meta p {
    margin-bottom: var(--space-3);
  }

  .article-body :global(h1) {
    margin-top: 0;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    margin-top: var(--space-6);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .article-body :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    -webkit-overflow-scrolling: touch;
  }

  .article-body :global(th),
  .article-body :global(td) {
    min-width: 8rem;
    border: 1px solid var(--color-border);
    padding: var(--space-2);
    text-align: left;
    vertical-align: top;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-list span {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.05rem 0.45rem;
    font-size: var(--text-xs);
  }

  .byline {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .disclaimer-note {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-3);
    color: var(--color-muted);
  }
</style>
