---
import Layout from '../../components/Layout.astro';
import MovingOsSales from '../../components/MovingOsSales.astro';
import Faq from '../../components/Faq.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { movingOsProduct } from '../../config/products';
import '../../styles/product-sales.css';
const title = '搬家與新居規劃系統｜家具尺寸、紙箱、預算一次管理｜RoomFeng';
const description = '用三關模型檢查家具搬運與房間尺寸，集中管理新家測量、搬家時間軸、紙箱、預算、家具採購、XLSX、列印表與本機備份。';
const canonical = '/zh/moving-new-home-os/';
const alternates = { en: '/en/moving-new-home-os/', zh: canonical };
const jsonLd = [
  { '@context':'https://schema.org', '@type':'Product', name:'RoomFeng 搬家與新居規劃系統', description, brand:{'@type':'Brand',name:'RoomFeng'}, category:'搬家規劃軟體與數位工作簿', offers:{'@type':'Offer',price:'12.99',priceCurrency:'USD',availability:'https://schema.org/InStock',url:`https://roomfeng.win${canonical}`} },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'首頁',item:'https://roomfeng.win/zh/'},{'@type':'ListItem',position:2,name:'搬家與新居規劃系統',item:`https://roomfeng.win${canonical}`}] },
];
const faqItems = [
  { q:'家具判斷會保證搬得進去嗎？', a:'不會。這是搬家前尺寸初步檢查；複雜三維旋轉、材料彈性、現場障礙與搬運技巧仍需要搬家公司現場確認。' },
  { q:'需要 RoomFeng 帳號嗎？', a:'不需要。產品使用購買平台提供的授權碼，不要求建立 RoomFeng 帳號。' },
  { q:'這是訂閱制嗎？', a:'不是。v1.0 是一次購買，價格以 Payhip 或 Gumroad checkout 顯示為準。' },
  { q:'我的搬家資料儲存在哪裡？', a:'房間尺寸、地址、家具、預算、紙箱與筆記留在目前瀏覽器。只有授權碼會送往安全驗證端點。你可以主動匯出 JSON 備份，再於同一或另一個瀏覽器還原。' },
  { q:'換電腦後怎麼使用？', a:'在原瀏覽器匯出 JSON 備份，於新瀏覽器使用有效授權碼啟用，再還原備份。' },
  { q:'可以切換幣別與尺寸單位嗎？', a:'可以。介面支援毫米、公分與英吋，內部統一以毫米保存；幣別支援 TWD、USD、EUR、GBP、JPY、KRW、HKD 與 SGD，但不做匯率換算。' },
  { q:'這是 CAD 軟體嗎？', a:'不是。這是給一般搬家家庭使用的實務決策系統，不取代建築、結構、室內設計或搬家公司的專業評估。' },
  { q:'Payhip 和 Gumroad 有差別嗎？', a:'沒有。兩個平台提供相同的 v1.0 商品，價格都是 US$12.99，選你習慣的 checkout 即可。' },
];
const relatedLinks = [{href:'/zh/moving-furniture-size-check/',title:'搬家家具尺寸檢查'}, {href:'/zh/room-layout-planner/',title:'免費房間配置工具'}, {href:'/privacy/',title:'RoomFeng 隱私政策'}];
---
<Layout title={title} description={description} canonical={canonical} lang="zh" alternates={alternates} jsonLd={jsonLd} pageType="tool">
  <MovingOsSales locale="zh-TW" activationHref="/zh/moving-new-home-os/activate/" previewHref={movingOsProduct.previewPackUrl} providers={movingOsProduct.providers} priceLabel={`${movingOsProduct.displayPrice.currency} ${movingOsProduct.displayPrice.amount.toFixed(2)}`} supportEmail={movingOsProduct.supportEmail} refundPolicyUrl={movingOsProduct.refundPolicyUrl} />
  <section class="section"><div class="container"><Faq items={faqItems} /><RelatedLinks links={relatedLinks} /></div></section>
</Layout>
